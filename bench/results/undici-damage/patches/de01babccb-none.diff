diff --git a/test/interceptors/cache.js b/test/interceptors/cache.js
index 39a659fd..b6683501 100644
--- a/test/interceptors/cache.js
+++ b/test/interceptors/cache.js
@@ -2779,4 +2779,74 @@ describe('Cache Interceptor', () => {
       }
     })
   })
+
+  // https://www.rfc-editor.org/rfc/rfc9111.html#section-3
+  // https://www.rfc-editor.org/rfc/rfc9111.html#section-5.2.2.4
+  describe('revalidation-only responses', () => {
+    /**
+     * Serves `cacheControl` + an etag (plus any extra headers) on the first
+     * request and a 304 to any conditional request, returning the sequence of
+     * request kinds the origin saw.
+     */
+    async function requestTwice (cacheControl, extraHeaders = {}) {
+      const requestsToOrigin = []
+
+      const server = createServer({ joinDuplicateHeaders: true }, (req, res) => {
+        requestsToOrigin.push(req.headers['if-none-match'] ? 'conditional' : 'full')
+
+        if (req.headers['if-none-match'] === '"asd"') {
+          res.statusCode = 304
+          res.end()
+          return
+        }
+
+        res.setHeader('cache-control', cacheControl)
+        res.setHeader('etag', '"asd"')
+        for (const [key, value] of Object.entries(extraHeaders)) {
+          res.setHeader(key, value)
+        }
+        res.end('asd')
+      }).listen(0)
+
+      const client = new Client(`http://localhost:${server.address().port}`)
+        .compose(interceptors.cache())
+
+      after(async () => {
+        server.close()
+        await client.close()
+      })
+
+      await once(server, 'listening')
+
+      const request = { origin: 'localhost', method: 'GET', path: '/' }
+
+      for (let i = 0; i < 2; i++) {
+        const res = await client.request(request)
+        equal(res.statusCode, 200)
+        strictEqual(await res.body.text(), 'asd')
+      }
+
+      return requestsToOrigin
+    }
+
+    test('stores no-cache response with an etag and revalidates it on reuse', async () => {
+      const requestsToOrigin = await requestTwice('no-cache')
+
+      strictEqual(requestsToOrigin.join(', '), 'full, conditional')
+    })
+
+    test('stores max-age=0 response with an etag and revalidates it on reuse', async () => {
+      const requestsToOrigin = await requestTwice('max-age=0')
+
+      strictEqual(requestsToOrigin.join(', '), 'full, conditional')
+    })
+
+    test('keeps caching no-cache responses that also have a Last-Modified header', async () => {
+      const requestsToOrigin = await requestTwice('no-cache', {
+        'last-modified': new Date(0).toUTCString()
+      })
+
+      strictEqual(requestsToOrigin.join(', '), 'full, conditional')
+    })
+  })
 })
