+test('ProxyAgent fails the request when the proxy closes the connection', async (t) => {
+  t = tspl(t, { plan: 4 })
+
+  // A plain HTTP server without a `connect` listener: node closes the socket
+  // when it receives the CONNECT request used to establish the tunnel.
+  const proxy = createServer((req, res) => {
+    t.fail('proxy should never receive a plain request')
+  })
+  let connections = 0
+  proxy.on('connection', () => { connections++ })
+  await new Promise(resolve => proxy.listen(0, resolve))
+
+  const proxyAgent = new ProxyAgent(`http://localhost:${proxy.address().port}`)
+
+  try {
+    await request('http://localhost:1/', { dispatcher: proxyAgent })
+    t.fail('should fail')
+  } catch (err) {
+    t.ok(err instanceof ProxyConnectionError)
+    t.strictEqual(err.code, 'UND_ERR_PRX_CONN')
+    t.strictEqual(err.cause.code, 'UND_ERR_SOCKET')
+    // The request must not be retried against the proxy over and over.
+    t.strictEqual(connections, 1)
+  }
+
+  proxy.close()
+  await proxyAgent.close()
+})
+
