+  })
+
+  let controller
+  let resumed = false
+  let body = ''
+  const completed = new Promise(resolve => {
+    const handler = {
+      onRequestStart (ctrl) {
+        controller = ctrl
+      },
+
+      onResponseStart () {},
+
+      onResponseData (_ctrl, chunk) {
+        body += chunk.toString()
+        controller.pause()
+        setTimeout(() => {
+          resumed = true
+          controller.resume()
+        }, 50)
+      },
+
+      onResponseEnd () {
+        t.ok(resumed, 'completion waits for the consumer to resume')
+        t.equal(body, data)
+        resolve()
+      },
+
+      onResponseError (_ctrl, err) {
+        t.fail(err)
+      }
+    }
+
+    client.dispatch({ method: 'GET', path: '/' }, handler)
+  })
+
+  await completed
+
+  t.ok(resumed)
+
+  await t.completed
+})
