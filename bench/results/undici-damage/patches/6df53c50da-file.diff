+/**
+ * Removes a finished request from the queue.
+ *
+ * HTTP/2 streams can complete out of order, so the request that finished is
+ * not necessarily the one sitting at `kRunningIdx`. Only advance the index
+ * when the request completed in order, otherwise splice it out so that the
+ * other running requests keep their slots.
+ *
+ * @param {import('./client.js')} client
+ * @param {import('../core/request.js')} request
+ * @returns {boolean} whether the request was still queued
+ */
+function removeQueuedRequest (client, request) {
+  const queue = client[kQueue]
+
+  for (let i = client[kRunningIdx]; i < queue.length; i++) {
+    if (queue[i] !== request) {
+      continue
+    }
+
+    if (i === client[kRunningIdx] && i < client[kPendingIdx]) {
+      // In-order completion, keep the amortized O(1) fast path.
+      queue[i] = null
+      client[kRunningIdx]++
+    } else {
+      // Either an out-of-order completion, or a request that was moved back
+      // into the pending section (e.g. by GOAWAY or socket close) before it
+      // finished. Drop just this entry so the indices stay consistent.
+      queue.splice(i, 1)
+
+      if (i < client[kPendingIdx]) {
+        client[kPendingIdx]--
+      }
+    }
+
+    return true
+  }
+
+  return false
+}
