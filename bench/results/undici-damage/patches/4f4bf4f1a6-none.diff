diff --git a/test/fetch/401-statuscode-no-infinite-loop.js b/test/fetch/401-statuscode-no-infinite-loop.js
index 96611718..04a4efb6 100644
--- a/test/fetch/401-statuscode-no-infinite-loop.js
+++ b/test/fetch/401-statuscode-no-infinite-loop.js
@@ -20,3 +20,38 @@ test('Receiving a 401 status code should not cause infinite retry loop', async (
   const response = await fetch(`http://localhost:${server.address().port}`)
   assert.strictEqual(response.status, 401)
 })
+
+test('Receiving a 401 status code on a POST request should not throw', async (t) => {
+  const server = createServer({ joinDuplicateHeaders: true }, (req, res) => {
+    req.resume()
+    res.statusCode = 401
+    res.end('Unauthorized')
+  }).listen(0)
+
+  t.after(closeServerAsPromise(server))
+  await once(server, 'listening')
+
+  const url = `http://localhost:${server.address().port}`
+
+  const response = await fetch(url, {
+    method: 'POST',
+    body: JSON.stringify({ data: 'test' })
+  })
+  assert.strictEqual(response.status, 401)
+
+  // A body created from a stream has a null source, so it cannot be
+  // re-extracted to retry the request.
+  const stream = new ReadableStream({
+    start (controller) {
+      controller.enqueue(new TextEncoder().encode('test'))
+      controller.close()
+    }
+  })
+
+  const streamedResponse = await fetch(url, {
+    method: 'POST',
+    body: stream,
+    duplex: 'half'
+  })
+  assert.strictEqual(streamedResponse.status, 401)
+})
