+// https://github.com/nodejs/undici/issues/5615
+test('cache.add and cache.addAll do not hang', async (t) => {
+  const server = createServer((req, res) => {
+    if (req.url === '/404') {
+      res.statusCode = 404
+      res.end('not found')
+    } else if (req.url === '/no-content') {
+      res.statusCode = 204
+      res.end()
+    } else if (req.url === '/vary-star') {
+      // Give /slow-body the time to start streaming before it is aborted.
+      setTimeout(() => {
+        res.setHeader('vary', '*')
+        res.end('varies')
+      }, 100)
+    } else if (req.url === '/slow-body') {
+      res.write('first chunk')
+      setTimeout(() => res.end('last chunk'), 500)
+    } else {
+      res.end(`body of ${req.url}`)
+    }
+  }).listen(0)
+
+  const cache = await caches.open('test-add')
+
+  t.after(closeServerAsPromise(server))
+  t.after(async () => {
+    await caches.delete('test-add')
+  })
+
+  await once(server, 'listening')
+
+  const origin = `http://localhost:${server.address().port}`
+
+  await cache.add(`${origin}/one`)
+
+  let match = await cache.match(`${origin}/one`)
+  t.assert.strictEqual(await match.text(), 'body of /one')
+
+  await cache.addAll([`${origin}/two`, new Request(`${origin}/three`)])
+
+  for (const path of ['/two', '/three']) {
+    match = await cache.match(`${origin}${path}`)
+    t.assert.strictEqual(await match.text(), `body of ${path}`)
+  }
+
+  // A cached response can be read more than once.
+  match = await cache.match(`${origin}/one`)
+  t.assert.strictEqual(await match.text(), 'body of /one')
+
+  // Responses without a body are supported as well.
+  await cache.add(`${origin}/no-content`)
+
+  match = await cache.match(`${origin}/no-content`)
+  t.assert.strictEqual(match.status, 204)
+  t.assert.strictEqual(await match.text(), '')
+
+  t.assert.deepStrictEqual(
+    (await cache.keys()).map((request) => new URL(request.url).pathname),
+    ['/one', '/two', '/three', '/no-content']
+  )
+
+  await t.assert.rejects(cache.add(`${origin}/404`), {
+    name: 'TypeError',
+    message: 'Cache.addAll: Received an invalid status code or the request failed.'
+  })
+
+  await t.assert.rejects(cache.add(`${origin}/vary-star`), {
+    name: 'TypeError',
+    message: 'Cache.addAll: invalid vary field value'
+  })
+
+  // Aborting the other in-flight fetches must not result in an unhandled
+  // rejection.
+  const onUnhandledRejection = (reason) => t.assert.fail(reason)
+  process.on('unhandledRejection', onUnhandledRejection)
+  t.after(() => process.off('unhandledRejection', onUnhandledRejection))
+
+  await t.assert.rejects(cache.addAll([`${origin}/slow-body`, `${origin}/vary-star`]), {
+    name: 'TypeError',
+    message: 'Cache.addAll: invalid vary field value'
+  })
+
+  await new Promise((resolve) => setTimeout(resolve, 100))
+})
