+// An empty body plus `connection: close`, flushed together with the FIN, makes
+// the response end while the retry policy is still deciding: the parser has
+// nothing left to buffer, so the EOF completes the message across the paused
+// controller. A raw socket is what keeps that framing exact.
+function closingRetryServer (shouldSucceed) {
+  return createNetServer(socket => {
+    socket.on('error', () => {})
+    socket.once('data', chunk => {
+      const path = chunk.toString().split(' ')[1]
+
+      if (!shouldSucceed(path)) {
+        socket.end('HTTP/1.1 500 Internal Server Error\r\nConnection: close\r\nContent-Length: 0\r\n\r\n')
+        return
+      }
+
+      const body = `hello ${path}`
+      socket.end(
+        'HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nConnection: close\r\n' +
+        `Content-Length: ${body.length}\r\n\r\n${body}`
+      )
+    })
+  })
+}
+
+function withDeadline (promise, message) {
+  let timer
+  return Promise.race([
+    promise.finally(() => clearTimeout(timer)),
+    new Promise((_resolve, reject) => {
+      timer = setTimeout(() => reject(new Error(message)), 10e3)
+    })
+  ])
+}
+
+test('Should retry concurrent responses that end after the connection is closed', async t => {
+  t = tspl(t, { plan: 7 })
+
+  const attempts = new Map()
+  const server = closingRetryServer(path => {
+    const count = (attempts.get(path) ?? 0) + 1
+    attempts.set(path, count)
+    return count === 3
+  })
+
+  server.listen(0)
+  await once(server, 'listening')
+
+  const client = new Client(
+    `http://localhost:${server.address().port}`
+  ).compose(retry({ minTimeout: 10, maxTimeout: 10, timeoutFactor: 1, throwOnError: false }))
+
+  after(async () => {
+    await client.close()
+    server.close()
+    await once(server, 'close')
+  })
+
+  const paths = ['/a', '/b', '/c']
+  const responses = await withDeadline(
+    Promise.all(paths.map(path => client.request({ method: 'GET', path }))),
+    'retry did not advance after the connection was closed'
+  )
+
+  for (let i = 0; i < paths.length; i++) {
+    t.strictEqual(responses[i].statusCode, 200)
+    t.strictEqual(
+      await withDeadline(responses[i].body.text(), 'response body never settled'),
+      `hello ${paths[i]}`
+    )
+  }
+
+  t.deepStrictEqual([...attempts.values()], [3, 3, 3])
+})
+
+test('Should expose the last closing response once retries are exhausted', async t => {
+  t = tspl(t, { plan: 3 })
+
+  let count = 0
+  const server = closingRetryServer(() => {
+    count++
+    return false
+  })
+
+  server.listen(0)
+  await once(server, 'listening')
+
+  const client = new Client(
+    `http://localhost:${server.address().port}`
+  ).compose(retry({ maxRetries: 2, minTimeout: 10, maxTimeout: 10, timeoutFactor: 1, throwOnError: false }))
+
+  after(async () => {
+    await client.close()
+    server.close()
+    await once(server, 'close')
+  })
+
+  const response = await withDeadline(
+    client.request({ method: 'GET', path: '/' }),
+    'exhausted retry never settled'
+  )
+
+  t.strictEqual(response.statusCode, 500)
+  t.strictEqual(
+    await withDeadline(response.body.text(), 'final response body never settled'),
+    ''
+  )
+  t.strictEqual(count, 3)
+})
+
