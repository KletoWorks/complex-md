+  test('shared cache does not store responses with set-cookie', async () => {
+    let requestsToOrigin = 0
+    const server = createServer({ joinDuplicateHeaders: true }, (_, res) => {
+      requestsToOrigin++
+      res.setHeader('cache-control', 'public, s-maxage=10')
+      res.setHeader('set-cookie', `session=${requestsToOrigin}`)
+      res.end('ok')
+    }).listen(0)
+
+    const store = new MemoryCacheStore()
+    const origin = `http://localhost:${server.address().port}`
+    const client = new Client(origin)
+      .compose(interceptors.cache({ store }))
+
+    after(async () => {
+      server.close()
+      await client.close()
+    })
+
+    await once(server, 'listening')
+
+    const request = { origin, method: 'GET', path: '/' }
+
+    {
+      const res = await client.request(request)
+      equal(requestsToOrigin, 1)
+      equal(res.headers['set-cookie'], 'session=1')
+      strictEqual(await res.body.text(), 'ok')
+    }
+
+    equal(store.get(makeCacheKey({ ...request, headers: {} })), undefined)
+
+    // Every caller must get their own cookie from the origin
+    {
+      const res = await client.request(request)
+      equal(requestsToOrigin, 2)
+      equal(res.headers['set-cookie'], 'session=2')
+      strictEqual(await res.body.text(), 'ok')
+    }
+  })
+
