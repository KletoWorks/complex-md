+/**
+ * A shared cache must not store or reuse a response containing a Set-Cookie
+ *  header: the cookie is scoped to the client that made the request, so
+ *  serving the stored response to anyone else discloses it.
+ *
+ * @see https://www.rfc-editor.org/rfc/rfc9111.html#section-7.3
+ *
+ * @param {import('../../types/cache-interceptor.d.ts').default.CacheOptions['type']} cacheType
+ * @param {import('../../types/header.d.ts').IncomingHttpHeaders | undefined} headers
+ * @returns {boolean}
+ */
+function isSetCookieDisallowed (cacheType, headers) {
+  return cacheType === 'shared' &&
+    headers != null &&
+    Object.hasOwn(headers, 'set-cookie') &&
+    headers['set-cookie'] !== undefined
+}
