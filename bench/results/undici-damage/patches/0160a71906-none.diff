+test('Should not resume a 206 exposed without a usable Content-Range', async t => {
+  t = tspl(t, { plan: 7 })
+
+  const chunks = []
+  let settle
+  const terminated = new Promise(resolve => { settle = resolve })
+
+  // A 206 without content-range is forwarded as-is, so nothing about its
+  // framing was checkpointed. Resuming it would let the second response be
+  // concatenated into the body the handler already received.
+  let x = 0
+  const server = createServer({ joinDuplicateHeaders: true }, (req, res) => {
+    if (x === 0) {
+      t.ok(true, 'pass')
+      res.statusCode = 206
+      res.write('abc')
+      setTimeout(() => {
+        res.destroy()
+      }, 1e2)
+    } else {
+      res.setHeader('content-range', 'bytes 3-5/6')
+      res.statusCode = 206
+      res.end('def')
+    }
+    x++
+  })
+
+  const dispatchOptions = {
+    retryOptions: {
+      retry: function (err, _, done) {
+        if (err.code && err.code === 'UND_ERR_DESTROYED') {
+          return done(false)
+        }
+
+        if (err.statusCode === 206) return done(err)
+
+        setTimeout(done, 800)
+      }
+    },
+    method: 'GET',
+    path: '/',
+    headers: {
+      'content-type': 'application/json'
+    }
+  }
+
+  server.listen(0, () => {
+    const client = new Client(`http://localhost:${server.address().port}`)
+    const handler = new RetryHandler(dispatchOptions, {
+      dispatch: (...args) => {
+        return client.dispatch(...args)
+      },
+      handler: {
+        onRequestStart () {
+          t.ok(true, 'pass')
+        },
+        onResponseStart (_controller, status, _headers, _statusMessage) {
+          t.strictEqual(status, 206)
+          return true
+        },
+        onResponseData (_controller, chunk) {
+          chunks.push(chunk)
+          return true
+        },
+        onResponseEnd () {
+          settle(null)
+        },
+        onResponseError (_controller, err) {
+          settle(err)
+        }
+      }
+    })
+
+    client.dispatch(
+      {
+        method: 'GET',
+        path: '/',
+        headers: {
+          'content-type': 'application/json'
+        }
+      },
+      handler
+    )
+
+    after(async () => {
+      await client.close()
+
+      server.close()
+      await once(server, 'close')
+    })
+  })
+
+  const err = await terminated
+  t.strictEqual(Buffer.concat(chunks).toString('utf-8'), 'abc')
+  t.strictEqual(err?.code, 'UND_ERR_REQ_RETRY')
+  t.strictEqual(err?.message, 'the response is not resumable')
+  t.strictEqual(x, 1, 'must not dispatch a resume request')
+
+  await t.completed
+})
+
