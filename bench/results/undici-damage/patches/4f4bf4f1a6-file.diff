diff --git a/test/fetch/401-statuscode-no-infinite-loop.js b/test/fetch/401-statuscode-no-infinite-loop.js
index 96611718..428c3809 100644
--- a/test/fetch/401-statuscode-no-infinite-loop.js
+++ b/test/fetch/401-statuscode-no-infinite-loop.js
@@ -20,3 +20,31 @@ test('Receiving a 401 status code should not cause infinite retry loop', async (
   const response = await fetch(`http://localhost:${server.address().port}`)
   assert.strictEqual(response.status, 401)
 })
+
+// https://github.com/nodejs/undici/issues/4990
+test('Receiving a 401 status code for a request with a non-replayable body', async (t) => {
+  const server = createServer({ joinDuplicateHeaders: true }, (req, res) => {
+    req.resume()
+    res.statusCode = 401
+    res.end('Unauthorized')
+  }).listen(0)
+
+  t.after(closeServerAsPromise(server))
+  await once(server, 'listening')
+
+  const body = new ReadableStream({
+    start (controller) {
+      controller.enqueue(new Uint8Array([1, 2, 3]))
+      controller.close()
+    }
+  })
+
+  const response = await fetch(`http://localhost:${server.address().port}`, {
+    method: 'POST',
+    body,
+    duplex: 'half'
+  })
+
+  assert.strictEqual(response.status, 401)
+  assert.strictEqual(await response.text(), 'Unauthorized')
+})
