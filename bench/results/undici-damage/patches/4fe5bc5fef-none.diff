+/**
+ * Adds the field names of a qualified `private` or `no-cache` directive (e.g.
+ *  `private="authorization"`) to the parsed directives.
+ *
+ * A qualified directive with an empty argument (e.g. `private=""`) carries no
+ *  field names, so it's handled as if it was unqualified. The same goes for an
+ *  argument that only contains empty field names (e.g. `private=", "`).
+ *
+ * @param {import('../../types/cache-interceptor.d.ts').default.CacheControlDirectives} output
+ * @param {'private' | 'no-cache'} key
+ * @param {string[]} fieldNames
+ */
+function addQualifiedFieldNames (output, key, fieldNames) {
+  const parsedFieldNames = []
+  for (let i = 0; i < fieldNames.length; i++) {
+    const fieldName = fieldNames[i].trim()
+    if (fieldName.length !== 0) {
+      parsedFieldNames.push(fieldName)
+    }
+  }
+
+  if (parsedFieldNames.length === 0) {
+    // Nothing was qualified, treat it as the unqualified directive
+    output[key] = true
+    return
+  }
+
+  const existing = output[key]
+  if (existing === true) {
+    // The unqualified directive already applies to every field name
+    return
+  }
+
+  output[key] = existing === undefined ? parsedFieldNames : existing.concat(parsedFieldNames)
+}
