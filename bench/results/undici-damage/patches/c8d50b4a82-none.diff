+test('request malformed content-length header', async (t) => {
+  const malformed = ['', ' ', '10.5', '+10', '-1', '10abc', ' 10', '10 ', '0x10', 'asd', ['10'], 10.5, -1, NaN]
+  t = tspl(t, { plan: malformed.length })
+
+  const client = new Client('http://localhost:3000')
+  after(() => client.close())
+
+  for (const value of malformed) {
+    client.request({
+      path: '/',
+      method: 'PUT',
+      headers: {
+        'content-length': value
+      },
+      body: 'asd'
+    }, (err) => {
+      t.ok(err instanceof errors.InvalidArgumentError, `${String(value)} should be rejected`)
+    })
+  }
+
+  await t.completed
