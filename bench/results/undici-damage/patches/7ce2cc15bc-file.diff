+++ b/test/cache/cache.js
@@ -1,6 +1,9 @@
 'use strict'
 
-const { test } = require('node:test')
+const { test, describe, before, after } = require('node:test')
+const { createServer } = require('node:http')
+const { once } = require('node:events')
+const { closeServerAsPromise } = require('../utils/node-http')
 const { Cache } = require('../../lib/web/cache/cache')
 const { caches, Response } = require('../../')
 
@@ -51,3 +54,93 @@ test('cache.match should work after garbage collection', async (t) => {
     t.assert.deepStrictEqual(result, testData, `Iteration ${i}: response body should match`)
   }
 })
+
+// https://github.com/nodejs/undici/issues/5615
+describe('cache.add and cache.addAll', () => {
+  let server
+  let base
+
+  before(async () => {
+    server = createServer({ joinDuplicateHeaders: true }, (req, res) => {
+      switch (req.url) {
+        case '/404':
+          res.writeHead(404)
+          res.end('not found')
+          break
+        case '/vary':
+          res.writeHead(200, { vary: '*' })
+          res.end('varies')
+          break
+        case '/204':
+          res.writeHead(204)
+          res.end()
+          break
+        default:
+          res.writeHead(200, { 'content-type': 'text/plain' })
+          res.end(`body for ${req.url}`)
+      }
+    }).listen(0)
+
+    await once(server, 'listening')
+
+    base = `http://localhost:${server.address().port}`
+  })
+
+  after(() => closeServerAsPromise(server)())
+
+  test('add resolves and caches the response body', async (t) => {
+    const cache = await caches.open('add')
+    t.after(() => caches.delete('add'))
+
+    t.assert.strictEqual(await cache.add(`${base}/one`), undefined)
+
+    // The body must be readable, and readable more than once.
+    t.assert.strictEqual(await (await cache.match(`${base}/one`)).text(), 'body for /one')
+    t.assert.strictEqual(await (await cache.match(`${base}/one`)).text(), 'body for /one')
+  })
+
+  test('addAll resolves and caches every response', async (t) => {
+    const cache = await caches.open('add-all')
+    t.after(() => caches.delete('add-all'))
+
+    t.assert.strictEqual(await cache.addAll([`${base}/one`, `${base}/two`, `${base}/204`]), undefined)
+
+    t.assert.deepStrictEqual(
+      (await cache.keys()).map((request) => new URL(request.url).pathname),
+      ['/one', '/two', '/204']
+    )
+
+    t.assert.strictEqual(await (await cache.match(`${base}/one`)).text(), 'body for /one')
+    t.assert.strictEqual(await (await cache.match(`${base}/two`)).text(), 'body for /two')
+
+    const noContent = await cache.match(`${base}/204`)
+    t.assert.strictEqual(noContent.status, 204)
+    t.assert.strictEqual(await noContent.text(), '')
+  })
+
+  test('add rejects on a non-ok response', async (t) => {
+    const cache = await caches.open('add-404')
+    t.after(() => caches.delete('add-404'))
+
+    await t.assert.rejects(cache.add(`${base}/404`), TypeError)
+    t.assert.strictEqual(await cache.match(`${base}/404`), undefined)
+  })
+
+  test('addAll rejects on a `vary: *` response', async (t) => {
+    const cache = await caches.open('add-vary')
+    t.after(() => caches.delete('add-vary'))
+
+    await t.assert.rejects(cache.addAll([`${base}/vary`]), TypeError)
+    t.assert.strictEqual(await cache.match(`${base}/vary`), undefined)
+  })
+
+  test('addAll caches nothing when one request fails', async (t) => {
+    const cache = await caches.open('add-all-partial')
+    t.after(() => caches.delete('add-all-partial'))
+
+    await t.assert.rejects(cache.addAll([`${base}/one`, `${base}/404`]), TypeError)
+
+    t.assert.strictEqual(await cache.match(`${base}/one`), undefined)
+    t.assert.strictEqual(await cache.match(`${base}/404`), undefined)
+  })
+})
