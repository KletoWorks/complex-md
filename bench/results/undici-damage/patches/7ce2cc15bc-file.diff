+ * Reads a response's body to completion.
+ * @param {any} response an inner response
+ * @returns {Promise<Uint8Array|undefined>} the body's bytes, or undefined if
+ *   the response has no body
+ */
+function readResponseBody (response) {
+  const body = (response.internalResponse ?? response).body
+
+  if (body == null) {
+    return Promise.resolve(undefined)
+  }
+
+  const { promise, resolve, reject } = Promise.withResolvers()
+
+  readAllBytes(body.stream.getReader(), resolve, reject)
