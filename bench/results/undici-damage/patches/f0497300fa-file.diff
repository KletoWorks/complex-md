@@ -49,6 +49,47 @@ test('addAbortListener removes native AbortSignal listener', async () => {
   assert.equal(calls, 0)
 })
 
+test('addAbortListener supports a signal that is not an AbortSignal instance', async () => {
+  const ac = new AbortController()
+  // e.g. an AbortSignal coming from another realm, which fails `instanceof`.
+  const signal = {
+    aborted: false,
+    addEventListener: (...args) => ac.signal.addEventListener(...args),
+    removeEventListener: (...args) => ac.signal.removeEventListener(...args)
+  }
+  let calls = 0
+
+  const remove = util.addAbortListener(signal, () => {
+    calls++
+  })
+
+  ac.abort()
+  await new Promise((resolve) => setImmediate(resolve))
+
+  assert.equal(calls, 1)
+  assert.equal(typeof remove, 'function')
+})
+
+test('addAbortListener supports an EventEmitter', async () => {
+  const ee = new EventEmitter()
+  let calls = 0
+
+  const remove = util.addAbortListener(ee, () => {
+    calls++
+  })
+
+  remove()
+  ee.emit('abort')
+  assert.equal(calls, 0)
+
+  util.addAbortListener(ee, () => {
+    calls++
+  })
+
+  ee.emit('abort')
+  assert.equal(calls, 1)
+})
+
