diff --git a/test/cache-interceptor/cache-utils.js b/test/cache-interceptor/cache-utils.js
index 7b66e66d..9e0b4a00 100644
--- a/test/cache-interceptor/cache-utils.js
+++ b/test/cache-interceptor/cache-utils.js
@@ -42,3 +42,31 @@ test('normalizeHeaders handles headers from Map', (t) => {
 
   strictEqual(headers['x-test'], 'ok')
 })
+
+test('normalizeHeaders handles a flat array of keys and values', (t) => {
+  const { deepStrictEqual } = tspl(t, { plan: 3 })
+
+  deepStrictEqual(normalizeHeaders({ headers: [] }), {})
+  deepStrictEqual(normalizeHeaders({ headers: ['Host', 'example.com', 'X-Test', 'ok'] }), {
+    host: 'example.com',
+    'x-test': 'ok'
+  })
+  deepStrictEqual(normalizeHeaders({ headers: ['X-Test', ['a', 'b']] }), { 'x-test': ['a', 'b'] })
+})
+
+test('normalizeHeaders handles an array of key-value pairs', (t) => {
+  const { deepStrictEqual } = tspl(t, { plan: 1 })
+
+  deepStrictEqual(normalizeHeaders({ headers: [['Host', 'example.com'], ['X-Test', 'ok']] }), {
+    host: 'example.com',
+    'x-test': 'ok'
+  })
+})
+
+test('normalizeHeaders rejects invalid arrays', (t) => {
+  const { throws } = tspl(t, { plan: 3 })
+
+  throws(() => normalizeHeaders({ headers: ['X-Test'] }), /not a valid header map/)
+  throws(() => normalizeHeaders({ headers: [1, 'ok'] }), /not a valid header map/)
+  throws(() => normalizeHeaders({ headers: [['X-Test']] }), /not a valid header map/)
+})
