+test('HTTP/1.1 does not touch setsockopt when typeOfService is unset', async (t) => {
+  let called = false
+
+  const server = createServer((req, res) => {
+    res.end('ok')
+  })
+
+  server.listen(0)
+  await once(server, 'listening')
+
+  const client = new Client(`http://localhost:${server.address().port}`, {
+    connect: (opts, cb) => {
+      const socket = require('node:net').connect({
+        ...opts,
+        host: opts.hostname,
+        port: opts.port
+      }, () => {
+        cb(null, socket)
+      })
+      socket.setTypeOfService = () => {
+        called = true
+      }
+      return socket
+    }
+  })
+  after(() => client.close())
+  after(() => server.close())
+
+  await client.request({ path: '/', method: 'GET' })
+
+  if (called) {
+    throw new Error('Expected setTypeOfService not to be called')
+  }
+})
+
+test('HTTP/1.1 survives a throwing setTypeOfService', async (t) => {
+  const server = createServer((req, res) => {
+    res.end('ok')
+  })
+
+  server.listen(0)
+  await once(server, 'listening')
+
+  const client = new Client(`http://localhost:${server.address().port}`, {
+    connect: (opts, cb) => {
+      const socket = require('node:net').connect({
+        ...opts,
+        host: opts.hostname,
+        port: opts.port
+      }, () => {
+        cb(null, socket)
+      })
+      socket.setTypeOfService = () => {
+        const err = new Error('setTypeOfService EINVAL')
+        err.code = 'EINVAL'
+        throw err
+      }
+      return socket
+    }
+  })
+  after(() => client.close())
+  after(() => server.close())
+
+  const { statusCode, body } = await client.request({
+    path: '/',
+    method: 'GET',
+    typeOfService: 42
+  })
+
+  if (statusCode !== 200) {
+    throw new Error(`Expected statusCode 200, got ${statusCode}`)
+  }
+  await body.text()
+})
+
