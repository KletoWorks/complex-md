+/**
+ * Turns a Location or Content-Location header value into a cache key that can
+ *  be invalidated, or undefined if the value is unusable or doesn't point at
+ *  the request's origin.
+ *
+ * @see https://www.rfc-editor.org/rfc/rfc9111.html#name-invalidating-stored-response
+ *
+ * @param {import('../../types/cache-interceptor.d.ts').default.CacheKey} cacheKey
+ * @param {string | string[] | undefined} headerValue
+ * @returns {import('../../types/cache-interceptor.d.ts').default.CacheKey | undefined}
+ */
+function makeInvalidationKey (cacheKey, headerValue) {
+  if (typeof headerValue !== 'string' || headerValue.length === 0) {
+    // Duplicated (array) values are malformed for both headers, ignore them
+    return undefined
+  }
+
+  // The cache key's origin isn't guaranteed to be a parsable url, so parse it
+  //  up front and fall back to resolving against a placeholder origin, which
+  //  lets us tell relative references (always same-origin) apart from absolute
+  //  ones (which we can't verify without a parsable origin)
+  const requestOrigin = parseOrigin(cacheKey.origin)
+  const path = cacheKey.path.startsWith('/') ? cacheKey.path : `/${cacheKey.path}`
+  const base = `${requestOrigin ?? PLACEHOLDER_ORIGIN}${path}`
+
+  let url
+  try {
+    url = new URL(headerValue, base)
+  } catch {
+    return undefined
+  }
+
+  if (url.origin !== (requestOrigin ?? PLACEHOLDER_ORIGIN)) {
+    return undefined
+  }
+
+  return {
+    origin: cacheKey.origin,
+    method: 'GET',
+    path: `${url.pathname}${url.search}`
+  }
+}
+
+/**
+ * @param {string} origin
+ * @returns {string | undefined}
+ */
+function parseOrigin (origin) {
+  try {
+    const parsed = new URL(origin).origin
+    // Opaque origins (`null`) can't be compared for equality
+    return parsed === 'null' ? undefined : parsed
+  } catch {
+    return undefined
+  }
+}
