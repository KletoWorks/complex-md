+    async function startValidatorOnlyServer (headers) {
+      const state = { requestsToOrigin: 0, conditionalRequests: 0 }
+
+      const server = createServer({ joinDuplicateHeaders: true }, (req, res) => {
+        state.requestsToOrigin++
+
+        if (req.headers['if-none-match'] === '"asd"') {
+          state.conditionalRequests++
+          res.statusCode = 304
+          for (const [key, value] of Object.entries(headers)) {
+            res.setHeader(key, value)
+          }
+          res.end()
+          return
+        }
