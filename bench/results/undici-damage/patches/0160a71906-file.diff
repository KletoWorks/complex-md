+test('Should reject a resumed response whose content-range total does not match', async t => {
+  t = tspl(t, { plan: 4 })
+
+  let requests = 0
+  const server = createServer({ joinDuplicateHeaders: true }, (_req, res) => {
+    if (requests++ === 0) {
+      res.writeHead(200, { 'content-length': '12' })
+      res.write('AAAA')
+      setTimeout(() => res.socket.destroy(), 50)
+      return
+    }
+
+    // Same start, but a different entity: the total size disagrees with the
+    // framing checkpointed from the first response.
+    res.writeHead(206, { 'content-range': 'bytes 4-11/24', 'content-length': '8' })
+    res.end('XXXXXXXX')
+  })
+
+  server.listen(0)
+
+  await once(server, 'listening')
+
+  const client = new Client(
+    `http://localhost:${server.address().port}`
+  ).compose(retry({ maxRetries: 3, minTimeout: 10, maxTimeout: 10 }))
+
+  after(async () => {
+    await client.close()
+    server.close()
+
+    await once(server, 'close')
+  })
+
+  const response = await client.request({ method: 'GET', path: '/' })
+  t.strictEqual(response.statusCode, 200)
+
+  const chunks = []
+  await t.rejects(async () => {
+    for await (const chunk of response.body) {
+      chunks.push(chunk)
+    }
+  }, { code: 'UND_ERR_REQ_RETRY', message: 'Content-Range mismatch' })
+
+  t.strictEqual(Buffer.concat(chunks).toString(), 'AAAA')
+  t.strictEqual(requests, 2)
+})
