+test('Should not resume a truncated 206 without content-range', async t => {
+  t = tspl(t, { plan: 4 })
+
+  let requests = 0
+  const server = createServer({ joinDuplicateHeaders: true }, (_req, res) => {
+    if (requests++ === 0) {
+      res.writeHead(206, {
+        'content-type': 'multipart/byteranges; boundary=THIS_STRING_SEPARATES'
+      })
+      res.write('AAAA')
+      setTimeout(() => res.socket.destroy(), 50)
+      return
+    }
+
+    res.writeHead(206, { 'content-range': 'bytes 4-11/12', 'content-length': '8' })
+    res.end('XXXXXXXX')
+  })
+
+  server.listen(0)
+
+  await once(server, 'listening')
+
+  const client = new Client(
+    `http://localhost:${server.address().port}`
+  ).compose(retry({ maxRetries: 3, minTimeout: 10, maxTimeout: 10 }))
+
+  after(async () => {
+    await client.close()
+    server.close()
+
+    await once(server, 'close')
+  })
+
+  const response = await client.request({ method: 'GET', path: '/' })
+  t.strictEqual(response.statusCode, 206)
+
+  const chunks = []
+  await t.rejects(async () => {
+    for await (const chunk of response.body) {
+      chunks.push(chunk)
+    }
+  }, { code: 'UND_ERR_SOCKET' })
+
+  // The second response must not be appended to the body already exposed.
+  t.strictEqual(Buffer.concat(chunks).toString(), 'AAAA')
+  t.strictEqual(requests, 1)
+})
+
