@@ -112,6 +112,17 @@ function buildConnector ({ allowH2, preferH2, useH2c, maxCachedSessions, socketP
         port,
         host: hostname
       })
+
+      // The hostname might have already been resolved to an IP address, e.g. by
+      // the dns interceptor, in which case node does not keep track of the
+      // hostname the connection was made for. Expose it so that instrumentation
+      // based on the `net.client.socket` diagnostics channel can attribute the
+      // connection to the original hostname, like `servername` allows for TLS.
+      const originalHostname = servername || options.servername || util.getServerName(host)
+      if (socket._host == null && originalHostname) {
+        socket._host = originalHostname
+      }
+
       if (useH2c === true) {
         socket.alpnProtocol = 'h2'
       }
