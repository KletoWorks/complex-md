+/**
+ * Records a qualified `private` or `no-cache` directive (one given with a list
+ *  of field names). An empty list, e.g. `private=""`, qualifies nothing, so the
+ *  directive is applied to the entire response as if it were unqualified. An
+ *  unqualified occurrence always wins over a qualified one.
+ *
+ * @see https://www.rfc-editor.org/rfc/rfc9111.html#name-private
+ *
+ * @param {import('../../types/cache-interceptor.d.ts').default.CacheControlDirectives} output
+ * @param {'private' | 'no-cache'} key
+ * @param {string[]} fieldNames
+ */
+function addQualifiedDirective (output, key, fieldNames) {
+  const current = output[key]
+
+  if (current === true) {
+    return
+  }
+
+  if (fieldNames.length === 0) {
+    output[key] = true
+    return
+  }
+
+  output[key] = current === undefined ? fieldNames : current.concat(fieldNames)
+}
