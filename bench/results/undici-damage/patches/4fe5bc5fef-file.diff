+  test('empty qualified no-cache and private are treated as unqualified', () => {
+    let directives = parseCacheControlHeader('max-age=10, private="", only-if-cached')
+    deepStrictEqual(directives, {
+      'max-age': 10,
+      private: true,
+      'only-if-cached': true
+    })
+
+    directives = parseCacheControlHeader('no-cache=""')
+    deepStrictEqual(directives, { 'no-cache': true })
+
+    // Nothing but whitespace or empty field names
+    directives = parseCacheControlHeader('private=" "')
+    deepStrictEqual(directives, { private: true })
+
+    directives = parseCacheControlHeader('private=", "')
+    deepStrictEqual(directives, { private: true })
+
+    directives = parseCacheControlHeader('private= ')
+    deepStrictEqual(directives, { private: true })
+
+    // Only a leading quote, invalid & should be skipped
+    directives = parseCacheControlHeader('max-age=10, private="')
+    deepStrictEqual(directives, { 'max-age': 10 })
+  })
+
+  test('an unqualified no-cache or private takes precedence over a qualified one', () => {
+    let directives = parseCacheControlHeader('private, private="some-header"')
+    deepStrictEqual(directives, { private: true })
+
+    directives = parseCacheControlHeader('private="some-header", private')
+    deepStrictEqual(directives, { private: true })
+
+    directives = parseCacheControlHeader('no-cache="some-header", no-cache=""')
+    deepStrictEqual(directives, { 'no-cache': true })
+
+    // Qualified ones are still merged together
+    directives = parseCacheControlHeader('private="some-header", private=another-one')
+    deepStrictEqual(directives, {
+      private: [
+        'some-header',
+        'another-one'
+      ]
+    })
+  })
+
