+test('ProxyAgent does not loop when the proxy closes the tunnel socket - #4374', async (t) => {
+  t = tspl(t, { plan: 3 })
+
+  // A plain HTTP server without a 'connect' listener: node closes the socket of
+  // the tunnel request, which surfaces as UND_ERR_SOCKET.
+  const proxy = createServer((req, res) => res.end())
+  await new Promise(resolve => proxy.listen(0, resolve))
+
+  let connections = 0
+  proxy.on('connection', () => {
+    connections++
+  })
+
+  const proxyAgent = new ProxyAgent(`http://localhost:${proxy.address().port}`)
+  after(() => Promise.all([proxyAgent.close(), proxy.close()]))
+
+  await t.rejects(
+    request('http://localhost:1/', { dispatcher: proxyAgent }),
+    { code: 'UND_ERR_SOCKET' }
+  )
+
+  t.strictEqual(connections, 1, 'should not retry the tunnel connection')
+
+  // The failure must not be sticky either: the next request gets its own single
+  // attempt rather than being rejected by leftover state.
+  await t.rejects(
+    request('http://localhost:1/', { dispatcher: proxyAgent }),
+    { code: 'UND_ERR_SOCKET' }
+  )
+})
+
 function buildServer () {
