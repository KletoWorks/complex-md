+test('Should accept each client-side h2Options on its own', async t => {
+  t = tspl(t, { plan: 5 })
+
+  for (const h2Options of [
+    { maxConcurrentStreams: 10 },
+    { connectionWindowSize: 1024 },
+    { pingInterval: 0 }
+  ]) {
+    t.doesNotThrow(() => {
+      // eslint-disable-next-line
+      new Client('https://localhost:1000', {
+        allowH2: true,
+        h2Options
+      })
+    }, `h2Options: ${JSON.stringify(h2Options)}`)
+  }
+
+  t.throws(() => {
+    // eslint-disable-next-line
+    new Client('https://localhost:1000', {
+      allowH2: true,
+      h2Options: { maxConcurrentStreams: {} }
+    })
+  }, {
+    message: 'h2Options.maxConcurrentStreams must be a positive integer, greater than 0'
+  })
+
+  t.throws(() => {
+    // eslint-disable-next-line
+    new Client('https://localhost:1000', {
+      allowH2: true,
+      h2Options: { maxConcurrentStreams: -1 }
+    })
+  }, {
+    message: 'h2Options.maxConcurrentStreams must be a positive integer, greater than 0'
+  })
+
+  await t.completed
+})
+
