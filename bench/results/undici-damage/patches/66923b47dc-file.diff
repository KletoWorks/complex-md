@@ -112,6 +112,15 @@ function buildConnector ({ allowH2, preferH2, useH2c, maxCachedSessions, socketP
         port,
         host: hostname
       })
+
+      // When the address has already been resolved (e.g. by the DNS
+      // interceptor) node does not record a hostname on the socket, leaving
+      // `net.client.socket` subscribers with nothing but the IP. Keep the
+      // requested name around, as TLS does through `servername`.
+      if (servername != null && servername !== hostname && socket._host == null) {
+        socket._host = servername
+      }
+
       if (useH2c === true) {
         socket.alpnProtocol = 'h2'
       }
