@@ -4,6 +4,7 @@ const FakeTimers = require('@sinonjs/fake-timers')
 const { test, after } = require('node:test')
 const { isIP } = require('node:net')
 const { lookup } = require('node:dns')
+const diagnosticsChannel = require('node:diagnostics_channel')
 const { createServer } = require('node:http')
 const { createServer: createSecureServer } = require('node:https')
 const { once } = require('node:events')
@@ -2339,3 +2340,48 @@ test('#4234 - Should pass Pool requests without origin through', async t => {
   t.equal(await response.body.text(), 'hello world!')
   t.equal(lookupCount, 0)
 })
+
+test('Should keep the original hostname on the socket of a plain HTTP connection', async t => {
+  const ctx = t
+  t = tspl(t, { plan: 5 })
+
+  const server = createServer({ joinDuplicateHeaders: true })
+  server.on('request', (req, res) => {
+    t.equal(req.headers.host, `localhost:${server.address().port}`)
+    res.end('hello world!')
+  })
+
+  server.listen(0)
+  await once(server, 'listening')
+
+  const sockets = []
+  const onClientSocket = ({ socket }) => sockets.push(socket)
+  diagnosticsChannel.subscribe('net.client.socket', onClientSocket)
+  ctx.after(() => diagnosticsChannel.unsubscribe('net.client.socket', onClientSocket))
+
+  const client = new Agent().compose(dns({
+    lookup: (_origin, _opts, cb) => {
+      cb(null, [{ address: '127.0.0.1', family: 4 }])
+    }
+  }))
+
+  after(async () => {
+    await client.close()
+    server.close()
+    await once(server, 'close')
+  })
+
+  const response = await client.request({
+    method: 'GET',
+    path: '/',
+    origin: `http://localhost:${server.address().port}`
+  })
+
+  t.equal(response.statusCode, 200)
+  t.equal(await response.body.text(), 'hello world!')
+
+  // The connection is made to the resolved address, but instrumentation still
+  // needs to know which hostname asked for it.
+  t.equal(sockets.at(-1).remoteAddress, '127.0.0.1')
+  t.equal(sockets.at(-1)._host, 'localhost')
+})
