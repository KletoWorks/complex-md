+test('Fragmented uncompressed payload over total limit is rejected', async (t) => {
+  const limit = 1 * 1024 * 1024 // 1 MB
+  const fragmentSize = 768 * 1024 // 768 KB, under the limit on its own
+  const server = new WebSocketServer({
+    port: 0,
+    perMessageDeflate: false
+  })
+
+  t.after(() => server.close())
+  await once(server, 'listening')
+
+  let messageReceived = false
+
+  server.on('connection', (ws) => {
+    ws.send(Buffer.alloc(fragmentSize, 0x41), { binary: true, fin: false })
+    ws.send(Buffer.alloc(fragmentSize, 0x41), { binary: true, fin: true })
+  })
+
+  const agent = new Agent({
+    webSocket: {
+      maxPayloadSize: limit
+    }
+  })
+
+  t.after(() => agent.close())
+
+  const client = new WebSocket(`ws://127.0.0.1:${server.address().port}`, { dispatcher: agent })
+
+  client.addEventListener('message', () => {
+    messageReceived = true
+  })
+
+  const closePromise = once(client, 'close')
+  const timeoutPromise = sleep(5000)
+
+  await Promise.race([closePromise, timeoutPromise])
+
+  t.assert.strictEqual(messageReceived, false, 'Fragmented uncompressed message over total limit should be rejected')
+  t.assert.strictEqual(client.readyState, WebSocket.CLOSED, 'Connection should be closed after exceeding limit')
+})
+
+test('Fragmented uncompressed payload under total limit succeeds', async (t) => {
+  const limit = 1 * 1024 * 1024 // 1 MB
+  const fragmentSize = 256 * 1024 // 256 KB
+  const server = new WebSocketServer({
+    port: 0,
+    perMessageDeflate: false
+  })
+
+  t.after(() => server.close())
+  await once(server, 'listening')
+
+  server.on('connection', (ws) => {
+    ws.send(Buffer.alloc(fragmentSize, 0x41), { binary: true, fin: false })
+    ws.send(Buffer.alloc(fragmentSize, 0x41), { binary: true, fin: true })
+  })
+
+  const agent = new Agent({
+    webSocket: {
+      maxPayloadSize: limit
+    }
+  })
+
+  t.after(() => agent.close())
+
+  const client = new WebSocket(`ws://127.0.0.1:${server.address().port}`, { dispatcher: agent })
+
+  const [event] = await once(client, 'message')
+  t.assert.strictEqual(event.data.size, fragmentSize * 2, 'Fragments under the total limit should be delivered')
+  client.close()
+})
+
+test('Decompressed fragments count towards the limit cumulatively', async (t) => {
+  const limit = 1024
+  const extension = new PerMessageDeflate(new Map(), { maxPayloadSize: limit })
+
+  // The fragment decompresses to 600 bytes, which is under the limit on its own,
+  // but the 600 bytes already received for this message push it over.
+  const fragment = deflateRawSync(Buffer.alloc(600, 0x41))
+
+  const result = await Promise.race([
+    new Promise((resolve) => {
+      extension.decompress(fragment, false, resolve, 600)
+    }),
+    sleep(5000, new Error('timed out'))
+  ])
+
+  t.assert.ok(
+    result instanceof MessageSizeExceededError,
+    'Cumulative decompressed size over the limit should be rejected'
+  )
+})
+
