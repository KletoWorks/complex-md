diff --git a/test/websocket/receiver-unit.js b/test/websocket/receiver-unit.js
index 2ebea57d..3b2b74ab 100644
--- a/test/websocket/receiver-unit.js
+++ b/test/websocket/receiver-unit.js
@@ -2,10 +2,49 @@
 
 const { test } = require('node:test')
 const { ByteParser } = require('../../lib/web/websocket/receiver')
-const { states } = require('../../lib/web/websocket/constants')
+const { opcodes, states } = require('../../lib/web/websocket/constants')
 
 const invalidFrame = Buffer.from([0x82, 0x7F, 0x00, 0x80, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01])
 
+/**
+ * Creates an unmasked frame with a payload of at most 125 bytes.
+ */
+function createFrame (fin, opcode, payload) {
+  return Buffer.concat([
+    Buffer.from([(fin ? 0x80 : 0x00) | opcode, payload.length]),
+    payload
+  ])
+}
+
+function createHandler (calls) {
+  return {
+    readyState: states.CONNECTING,
+    controller: {
+      abort: () => {
+        calls.abort += 1
+      }
+    },
+    onSocketClose: () => {
+      calls.close += 1
+    },
+    onMessage: (type, data) => {
+      calls.messages.push(data)
+    },
+    onPing: () => {
+      calls.ping += 1
+    },
+    socket: {
+      destroyed: false,
+      write: () => {}
+    },
+    closeState: new Set()
+  }
+}
+
+function createCalls () {
+  return { abort: 0, close: 0, ping: 0, messages: [] }
+}
+
 test('ByteParser rejects 64-bit payload lengths with a non-zero upper word', (t) => {
