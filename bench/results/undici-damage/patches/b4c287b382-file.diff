+
+test('ByteParser rejects fragmented messages that exceed maxPayloadSize in total', (t) => {
+  const calls = createCalls()
+  const parser = new ByteParser(createHandler(calls), null, { maxPayloadSize: 100 })
+
+  parser.write(createFrame(false, opcodes.BINARY, Buffer.alloc(60, 0x41)))
+  parser.write(createFrame(true, opcodes.CONTINUATION, Buffer.alloc(60, 0x41)))
+
+  return new Promise((resolve) => {
+    setImmediate(() => {
+      t.assert.deepStrictEqual(calls.messages, [], 'no message should be delivered')
+      t.assert.strictEqual(calls.abort, 1)
+      t.assert.strictEqual(calls.close, 1)
+      parser.destroy()
+      resolve()
+    })
+  })
+})
+
+test('ByteParser accepts fragmented messages that total exactly maxPayloadSize', (t) => {
+  const calls = createCalls()
+  const parser = new ByteParser(createHandler(calls), null, { maxPayloadSize: 120 })
+
+  parser.write(createFrame(false, opcodes.BINARY, Buffer.alloc(60, 0x41)))
+  parser.write(createFrame(true, opcodes.CONTINUATION, Buffer.alloc(60, 0x41)))
+
+  return new Promise((resolve) => {
+    setImmediate(() => {
+      t.assert.strictEqual(calls.messages.length, 1)
+      t.assert.strictEqual(calls.messages[0].length, 120)
+      t.assert.strictEqual(calls.abort, 0)
+      parser.destroy()
+      resolve()
+    })
+  })
+})
+
+test('ByteParser does not count control frames towards a fragmented message', (t) => {
+  const calls = createCalls()
+  const parser = new ByteParser(createHandler(calls), null, { maxPayloadSize: 120 })
+
+  parser.write(createFrame(false, opcodes.BINARY, Buffer.alloc(60, 0x41)))
+  parser.write(createFrame(true, opcodes.PING, Buffer.alloc(2, 0x41)))
+  parser.write(createFrame(true, opcodes.CONTINUATION, Buffer.alloc(60, 0x41)))
+
+  return new Promise((resolve) => {
+    setImmediate(() => {
+      t.assert.strictEqual(calls.ping, 1)
