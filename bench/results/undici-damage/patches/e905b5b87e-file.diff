+test('#3900823 - Should settle the exposed body when a late retry decision is terminal', async t => {
+  t = tspl(t, { plan: 4 })
+
+  let x = 0
+  const server = createServer({ joinDuplicateHeaders: true }, (req, res) => {
+    if (x === 0) {
+      // Retryable status, then the connection dies while the retry policy is
+      // still deciding, so a second dispatch starts before that decision lands.
+      res.writeHead(500, { 'content-length': '5' })
+      res.flushHeaders()
+      setTimeout(() => req.socket.destroy(), 20)
+    } else {
+      // The resumed dispatch exposes its response to the caller, then keeps the
+      // body open long enough for the stale decision to arrive.
+      res.writeHead(200, { 'content-length': '5' })
+      res.flushHeaders()
+      setTimeout(() => res.end('hello'), 1000)
+    }
+    x++
+  })
+
+  server.listen(0)
+
+  await once(server, 'listening')
+
+  let policyCalls = 0
+  const client = new Client(
+    `http://localhost:${server.address().port}`
+  ).compose(retry({
+    throwOnError: false,
+    retry (err, _ctx, done) {
+      policyCalls++
+
+      // A custom policy may decide asynchronously; the first decision is
+      // terminal but only arrives once the retry is already streaming.
+      if (policyCalls === 1) {
+        setTimeout(() => done(err), 300)
+        return
+      }
+
+      setTimeout(() => done(null), 0)
+    }
+  }))
+
+  after(async () => {
+    await client.destroy()
+    server.closeAllConnections()
+    server.close()
+
+    await once(server, 'close')
+  })
+
+  const response = await client.request({ method: 'GET', path: '/' })
+  t.strictEqual(response.statusCode, 200)
+  // The terminal error must reach the body the caller already holds instead of
+  // being forwarded as a replacement response, which would stall this read.
+  await t.rejects(response.body.text(), {
+    name: 'RequestRetryError',
+    code: 'UND_ERR_REQ_RETRY'
+  })
+  t.strictEqual(x, 2)
+  t.strictEqual(policyCalls, 2)
+})
+
