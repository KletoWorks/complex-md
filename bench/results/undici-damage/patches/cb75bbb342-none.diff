+/**
+ * A Set-Cookie header targets the single user the response was made for, so a
+ *  shared cache can neither store nor re-serve it without leaking that cookie
+ *  to every later caller of the same resource. Private caches only ever serve
+ *  the user the response belongs to, so they keep it.
+ *
+ * @see https://www.rfc-editor.org/rfc/rfc6265.html#section-4.1
+ * @see https://www.rfc-editor.org/rfc/rfc9111.html#section-3
+ *
+ * @param {import('../../types/cache-interceptor.d.ts').default.CacheOptions['type']} cacheType
+ * @param {import('../../types/header.d.ts').IncomingHttpHeaders | undefined} headers
+ * @returns {boolean}
+ */
+function hasUncacheableSetCookie (cacheType, headers) {
+  return cacheType === 'shared' && headers != null && Object.hasOwn(headers, 'set-cookie')
+}
