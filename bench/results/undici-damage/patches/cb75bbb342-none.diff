+        if (requestsToOrigin === 2) {
+          equal(req.headers['if-none-match'], '"asd"')
+          res.setHeader('set-cookie', 'session=secret-on-304')
+          res.statusCode = 304
+          res.end()
+          return
+        }
+
+        res.end(`body-${requestsToOrigin}`)
+      }).listen(0)
+
+      after(() => server.close())
+      await once(server, 'listening')
+
+      const client = new Client(`http://localhost:${server.address().port}`)
+        .compose(interceptors.cache())
+
+      after(() => client.close())
+
+      const request = {
+        origin: 'localhost',
+        method: 'GET',
+        path: '/'
+      }
+
+      strictEqual(await (await client.request(request)).body.text(), 'body-1')
+
+      await sleep(1500)
+
+      {
+        // The 304's Set-Cookie can't be merged into the stored entry, so the
