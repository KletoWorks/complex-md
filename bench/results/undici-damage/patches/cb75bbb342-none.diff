+        equal(res.headers['set-cookie'], undefined)
+        await res.body.dump()
+      }
+    })
+
+    test('does not store a background revalidation response with Set-Cookie', async () => {
+      let requestsToOrigin = 0
+      const server = createServer({ joinDuplicateHeaders: true }, (_, res) => {
+        requestsToOrigin++
+        res.setHeader('cache-control', 'public, max-age=1, stale-while-revalidate=60')
+        if (requestsToOrigin > 1) {
+          res.setHeader('set-cookie', `session=secret-${requestsToOrigin}`)
+        }
+        res.end(`body-${requestsToOrigin}`)
+      }).listen(0)
+
+      after(() => server.close())
+      await once(server, 'listening')
+
+      const client = new Client(`http://localhost:${server.address().port}`)
+        .compose(interceptors.cache())
+
+      after(() => client.close())
+
+      const request = {
+        origin: 'localhost',
+        method: 'GET',
+        path: '/'
+      }
+
+      strictEqual(await (await client.request(request)).body.text(), 'body-1')
+
+      await sleep(1500)
+
+      {
+        // Stale response served while revalidating in the background.
+        const res = await client.request(request)
+        equal(res.headers['set-cookie'], undefined)
+        strictEqual(await res.body.text(), 'body-1')
+      }
+
+      await sleep(500)
+      equal(requestsToOrigin, 2)
+
+      {
+        // The cookie-bearing background response was never stored.
+        const res = await client.request(request)
+        equal(res.headers['set-cookie'], undefined)
+        notEqual(await res.body.text(), 'body-2')
+      }
+    })
+  })
 })
