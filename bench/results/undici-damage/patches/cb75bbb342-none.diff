@@ -4466,4 +4466,233 @@ describe('Cache Interceptor', () => {
       }
     })
   })
+
+  describe('Set-Cookie in shared caches', () => {
+    test('does not store a response with Set-Cookie in a shared cache', async () => {
+      let requestsToOrigin = 0
+      const server = createServer({ joinDuplicateHeaders: true }, (_, res) => {
+        requestsToOrigin++
+        res.setHeader('cache-control', 'public, max-age=60')
+        res.setHeader('set-cookie', `session=secret-${requestsToOrigin}`)
+        res.end('ok')
+      }).listen(0)
+
+      after(() => server.close())
+      await once(server, 'listening')
+
+      const client = new Client(`http://localhost:${server.address().port}`)
+        .compose(interceptors.cache())
+
+      after(() => client.close())
+
+      const request = {
+        origin: 'localhost',
+        method: 'GET',
+        path: '/'
+      }
+
+      {
+        const res = await client.request(request)
+        equal(requestsToOrigin, 1)
+        equal(res.headers['set-cookie'], 'session=secret-1')
+        strictEqual(await res.body.text(), 'ok')
+      }
+
+      {
+        const res = await client.request(request)
+        equal(requestsToOrigin, 2)
+        equal(res.headers['set-cookie'], 'session=secret-2')
+        strictEqual(await res.body.text(), 'ok')
+      }
+    })
+
+    test('stores a response with Set-Cookie in a private cache', async () => {
+      let requestsToOrigin = 0
+      const server = createServer({ joinDuplicateHeaders: true }, (_, res) => {
+        requestsToOrigin++
+        res.setHeader('cache-control', 'public, max-age=60')
+        res.setHeader('set-cookie', `session=secret-${requestsToOrigin}`)
+        res.end('ok')
+      }).listen(0)
+
+      after(() => server.close())
+      await once(server, 'listening')
+
+      const client = new Client(`http://localhost:${server.address().port}`)
+        .compose(interceptors.cache({ type: 'private' }))
+
+      after(() => client.close())
+
+      const request = {
+        origin: 'localhost',
+        method: 'GET',
+        path: '/'
+      }
+
+      {
+        const res = await client.request(request)
+        equal(requestsToOrigin, 1)
+        equal(res.headers['set-cookie'], 'session=secret-1')
+        strictEqual(await res.body.text(), 'ok')
+      }
+
+      {
+        const res = await client.request(request)
+        equal(requestsToOrigin, 1)
+        equal(res.headers['set-cookie'], 'session=secret-1')
+        strictEqual(await res.body.text(), 'ok')
+      }
+    })
+
+    test('does not serve an existing cache entry containing Set-Cookie', async () => {
+      let requestsToOrigin = 0
+      const server = createServer({ joinDuplicateHeaders: true }, (_, res) => {
+        requestsToOrigin++
+        res.setHeader('cache-control', 'public, max-age=60')
+        res.end('fresh')
+      }).listen(0)
+
+      after(() => server.close())
+      await once(server, 'listening')
+
+      // An entry stored before this was disallowed, or by a private cache
+      // sharing the same store.
+      const store = new MemoryCacheStore()
+      const cacheKey = {
+        origin: `http://localhost:${server.address().port}`,
+        method: 'GET',
+        path: '/'
+      }
+      const now = Date.now()
+      store.createWriteStream(cacheKey, {
+        statusCode: 200,
+        statusMessage: 'OK',
+        headers: {
+          'cache-control': 'public, max-age=60',
+          'set-cookie': 'session=someone-elses-secret'
+        },
+        cacheControlDirectives: { public: true, 'max-age': 60 },
+        cachedAt: now,
+        staleAt: now + 60000,
+        deleteAt: now + 120000
+      }).end('stale')
+
+      notEqual(store.get(cacheKey), undefined)
+
+      const client = new Client(`http://localhost:${server.address().port}`)
+        .compose(interceptors.cache({ store }))
+
+      after(() => client.close())
+
+      const res = await client.request({
+        origin: 'localhost',
+        method: 'GET',
+        path: '/'
+      })
+      equal(requestsToOrigin, 1)
+      equal(res.headers['set-cookie'], undefined)
+      strictEqual(await res.body.text(), 'fresh')
+
+      // The entry was dropped rather than left around for the next caller.
+      equal(store.get(cacheKey)?.headers['set-cookie'], undefined)
+    })
+
+    test('does not reuse a cached response when revalidation responds with Set-Cookie', async () => {
+      let requestsToOrigin = 0
+      const server = createServer({ joinDuplicateHeaders: true }, (req, res) => {
+        requestsToOrigin++
