@@ -285,6 +286,13 @@ function buildRouting (options) {
       opts.prefix = prefix
       opts.logLevel = opts.logLevel || this[kLogLevel]
 
+      // pino-compatible loggers expose their known levels; fail fast on unknown ones
+      // instead of throwing when the child logger is created for each request
+      const levelValues = this.log?.levels?.values
+      if (levelValues && opts.logLevel && !(opts.logLevel in levelValues)) {
