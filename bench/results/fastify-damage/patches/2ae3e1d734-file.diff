+/**
+ * Determines if a log level can be used to create a child logger.
+ * An unknown level would make the logger throw when the child logger is
+ * created, which happens once per request, so levels are validated upfront.
+ *
+ * @param {object} logger The logger the child logger will be derived from.
+ * @param {string|number|undefined} level The level to validate. A falsy level
+ * means "inherit from the logger" and is always valid.
+ *
+ * @throws {FST_ERR_LOG_INVALID_LOGGER_LEVEL} When the level is not supported
+ * by the logger.
+ */
+function validateLogLevel (logger, level) {
+  // The levels a logger supports are only known when it exposes them, as pino
+  // does. Loggers that do not (e.g. the no-op logger) accept anything.
+  const levels = logger?.levels?.values
+  if (!level || levels === undefined) {
+    return
+  }
+
+  // Numeric levels are passed through to the logger as they are.
+  if (typeof level === 'number' || level === 'silent' || Object.hasOwn(levels, level)) {
+    return
+  }
+
+  throw new FST_ERR_LOG_INVALID_LOGGER_LEVEL(level, Object.keys(levels).concat('silent').join("', '"))
+}
+
 function createLogger (options) {
   if (options.logger && options.loggerInstance) {
     throw new FST_ERR_LOG_LOGGER_AND_LOGGER_INSTANCE_PROVIDED()
@@ -132,5 +161,6 @@ module.exports = {
