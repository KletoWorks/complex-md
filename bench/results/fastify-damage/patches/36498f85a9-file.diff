+module.exports.closeHttp2Sessions = closeHttp2Sessions
+
+// Closes every HTTP/2 session opened on `server`, so that `server.close()`
+// can complete. It is a no-op for HTTP/1 and user provided servers.
+// A graceful `close()` lets the in-flight streams finish, while `force`
+// tears the sessions down right away.
+function closeHttp2Sessions (server, force) {
+  const sessions = server[kHttp2Sessions]
+  if (sessions === undefined) {
+    return
+  }
+
+  // The entries are removed by the session 'close' listener.
+  for (const session of sessions.values()) {
+    if (force) {
+      session.destroy()
+    } else {
+      session.close()
+    }
+  }
+}
 
