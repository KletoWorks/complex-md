diff --git a/test/http2/closing.test.js b/test/http2/closing.test.js
index 2d14090d..7543ac2f 100644
--- a/test/http2/closing.test.js
+++ b/test/http2/closing.test.js
@@ -180,3 +180,34 @@ test('http/2 server side session emits a timeout event', async t => {
   await p
   await fastify.close()
 })
+
+test('http/2 closes the open sessions on close', async t => {
+  const fastify = Fastify({
+    http2: true
+  })
+
+  fastify.get('/', async () => ({ hello: 'world' }))
+
+  await fastify.listen({ port: 0 })
+
+  const url = getServerUrl(fastify)
+  const session = await connect(url)
+  // An error might or might not happen, as it's OS dependent.
+  session.on('error', () => {})
+
+  const req = session.request({
+    ':method': 'GET',
+    ':path': '/'
+  }).end()
+
+  const [headers] = await once(req, 'response')
+  t.assert.strictEqual(headers[':status'], 200)
+  req.resume()
+
+  // The client keeps the session open: without closing the server side
+  // sessions, close() would only settle once the session times out.
+  // https://github.com/fastify/fastify/issues/5716
+  const sessionClosed = once(session, 'close')
+  await fastify.close()
+  await sessionClosed
+})
