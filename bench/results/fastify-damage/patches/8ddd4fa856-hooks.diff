+test('registering an unsupported hook should reject the ready promise', async t => {
+  t.plan(2)
+
+  const fastify = Fastify()
+  t.teardown(() => fastify.close())
+
+  fastify.addHook('invalidHook', () => {})
+
+  try {
+    await fastify.ready()
+    t.fail('ready should not resolve')
+  } catch (err) {
+    t.equal(err.code, 'FST_ERR_HOOK_NOT_SUPPORTED')
+    t.equal(err.message, 'invalidHook hook not supported!')
+  }
+})
+
+test('registering a hook with an invalid handler should reject the ready promise', async t => {
+  t.plan(2)
+
+  const fastify = Fastify()
+  t.teardown(() => fastify.close())
+
+  fastify.addHook('onRequest', 'not a function')
+
+  try {
+    await fastify.ready()
+    t.fail('ready should not resolve')
+  } catch (err) {
+    t.equal(err.code, 'FST_ERR_HOOK_INVALID_HANDLER')
+    t.equal(err.message, 'onRequest hook should be a function, instead got [object String]')
+  }
+})
+
