+test('Request with trust proxy - untrusted peer cannot spoof host/protocol', t => {
+  t.plan(6)
+  const headers = {
+    'x-forwarded-for': '2.2.2.2, 1.1.1.1',
+    'x-forwarded-host': 'fastify.test',
+    'x-forwarded-proto': 'https',
+    host: 'hostname:8080'
+  }
+  const req = {
+    method: 'GET',
+    url: '/',
+    // the request does not come from one of the trusted proxies
+    socket: { remoteAddress: '9.9.9.9' },
+    headers
+  }
+
+  const TpRequest = Request.buildRequest(Request, '127.0.0.1, 192.168.1.1')
+  const request = new TpRequest('id', 'params', req, 'query', 'log')
+  t.assert.strictEqual(request.host, 'hostname:8080')
+  t.assert.strictEqual(request.hostname, 'hostname')
+  t.assert.strictEqual(request.port, 8080)
+  t.assert.strictEqual(request.protocol, 'http')
+  t.assert.strictEqual(request.ip, '9.9.9.9')
+  t.assert.deepStrictEqual(request.ips, ['9.9.9.9'])
+})
+
+test('Request with trust proxy - trusted peer can set host/protocol', t => {
+  t.plan(4)
+  const headers = {
+    'x-forwarded-for': '1.1.1.1',
+    'x-forwarded-host': 'fastify.test',
+    'x-forwarded-proto': 'https',
+    host: 'hostname:8080'
+  }
+  const req = {
+    method: 'GET',
+    url: '/',
+    socket: { remoteAddress: '127.0.0.1' },
+    headers
+  }
+
+  const TpRequest = Request.buildRequest(Request, '127.0.0.1, 192.168.1.1')
+  const request = new TpRequest('id', 'params', req, 'query', 'log')
+  t.assert.strictEqual(request.host, 'fastify.test')
+  t.assert.strictEqual(request.protocol, 'https')
+  t.assert.strictEqual(request.ip, '1.1.1.1')
+  t.assert.deepStrictEqual(request.ips, ['127.0.0.1', '1.1.1.1'])
+})
+
