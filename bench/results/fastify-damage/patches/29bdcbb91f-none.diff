+test('Reply should append the charset when a quoted parameter value contains "charset="', async t => {
+  t.plan(2)
+
+  const fastify = require('../../')()
+
+  fastify.get('/quoted-charset', function (req, reply) {
+    reply
+      .header('content-type', 'application/json; name="a=b;charset=fake"')
+      .send({ hello: 'world' })
+  })
+
+  fastify.get('/quoted-semicolon', function (req, reply) {
+    reply
+      .header('content-type', 'application/json; name="foo;bar"')
+      .send({ hello: 'world' })
+  })
+
+  {
+    const res = await fastify.inject('/quoted-charset')
+    t.assert.strictEqual(
+      res.headers['content-type'],
+      'application/json; name="a=b;charset=fake"; charset=utf-8'
+    )
+  }
+
+  {
+    const res = await fastify.inject('/quoted-semicolon')
+    t.assert.strictEqual(
+      res.headers['content-type'],
+      'application/json; name="foo;bar"; charset=utf-8'
+    )
+  }
+})
