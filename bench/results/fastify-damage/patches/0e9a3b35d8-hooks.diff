diff --git a/test/http-methods/custom-http-methods.test.js b/test/http-methods/custom-http-methods.test.js
index 61feed4e..6b17369a 100644
--- a/test/http-methods/custom-http-methods.test.js
+++ b/test/http-methods/custom-http-methods.test.js
@@ -112,3 +112,67 @@ test('addHttpMethod rejects fake http method', t => {
   const fastify = Fastify()
   t.assert.throws(() => { fastify.addHttpMethod('FOOO') }, /Provided method is invalid!/)
 })
+
+async function collectWarnings (fn) {
+  const warnings = []
+  const listener = (w) => { warnings.push(w) }
+  process.on('warning', listener)
+  fn()
+  // warnings are emitted asynchronously
+  await new Promise(resolve => setImmediate(resolve))
+  process.removeListener('warning', listener)
+  return warnings
+}
+
+test('addHttpMethod warns when overriding the body support of a supported method', async t => {
+  t.plan(3)
+  const app = Fastify()
+
+  const warnings = await collectWarnings(() => { app.addHttpMethod('GET', { hasBody: true }) })
+
+  const warning = warnings.find(w => w.code === 'FSTWRN005')
+  t.assert.ok(warning, 'FSTWRN005 has been emitted')
+  t.assert.match(warning.message, /GET/)
+
+  // the override still takes place
+  addEcho(app, 'GET')
+  const response = await app.inject({ method: 'GET', url: '/', payload: { hello: 'world' } })
+  t.assert.deepStrictEqual(response.json(), { hello: 'world' })
+})
+
+test('addHttpMethod does not warn when the body support is unchanged', async t => {
+  t.plan(3)
+  const app = Fastify()
+
+  const warnings = await collectWarnings(() => {
+    // already supported with the same body support
+    app.addHttpMethod('TRACE')
+    app.addHttpMethod('POST', { hasBody: true })
+    // not supported by default
+    app.addHttpMethod('REBIND', { hasBody: true })
+  })
+
+  t.assert.deepStrictEqual(warnings.filter(w => w.code === 'FSTWRN005'), [])
+  t.assert.ok(app.supportedMethods.includes('REBIND'))
+  t.assert.ok(app.supportedMethods.includes('TRACE'))
+})
+
+test('addHttpMethod does not warn when the override is explicit', async t => {
+  t.plan(2)
+  const app = Fastify()
+
+  const warnings = await collectWarnings(() => {
+    app.addHttpMethod('GET', { hasBody: true, override: true })
+  })
+
+  t.assert.deepStrictEqual(warnings.filter(w => w.code === 'FSTWRN005'), [])
+
+  app.route({
+    method: 'GET',
+    url: '/',
+    handler: (req, reply) => { reply.send(req.body) }
+  })
+
+  const response = await app.inject({ method: 'GET', url: '/', payload: { hello: 'world' } })
+  t.assert.deepStrictEqual(response.json(), { hello: 'world' })
+})
