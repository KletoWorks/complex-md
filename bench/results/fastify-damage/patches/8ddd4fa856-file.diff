+test('addHook with an unsupported hook name should reject the ready promise', async t => {
+  t.plan(2)
+  const fastify = Fastify()
+
+  fastify.addHook('invalidHook', () => {})
+
+  await fastify.ready().then(
+    () => t.fail('should not be ready'),
+    err => {
+      t.equal(err.code, 'FST_ERR_HOOK_NOT_SUPPORTED')
+      t.equal(err.message, 'invalidHook hook not supported!')
+    }
+  )
+})
+
+test('addHook with an invalid handler should reject the ready promise', async t => {
+  t.plan(2)
+  const fastify = Fastify()
+
+  fastify.addHook('onRequest', 'not a function')
+
+  await fastify.ready().then(
+    () => t.fail('should not be ready'),
