+test('trust proxy derives port from x-forwarded-host', t => {
+  t.plan(3)
+
+  const req = {
+    method: 'GET',
+    url: '/',
+    socket: { remoteAddress: '1.1.1.1' },
+    headers: {
+      host: 'real.test:8080',
+      'x-forwarded-host': 'fastify.test:4567'
+    }
+  }
+
+  const TpRequest = buildRequest(Request, true)
+  const request = new TpRequest('id', 'params', req, 'query', 'log')
+  t.assert.strictEqual(request.host, 'fastify.test:4567', 'gets host from x-forwarded-host')
+  t.assert.strictEqual(request.hostname, 'fastify.test', 'gets hostname from x-forwarded-host')
+  t.assert.strictEqual(request.port, 4567, 'gets port from x-forwarded-host')
+})
+
+test('trust proxy port is null when x-forwarded-host has no port', t => {
+  t.plan(2)
+
+  const req = {
+    method: 'GET',
+    url: '/',
+    socket: { remoteAddress: '1.1.1.1' },
+    headers: {
+      host: 'real.test:8080',
+      'x-forwarded-host': 'fastify.test'
+    }
+  }
+
+  const TpRequest = buildRequest(Request, true)
+  const request = new TpRequest('id', 'params', req, 'query', 'log')
+  t.assert.strictEqual(request.host, 'fastify.test', 'gets host from x-forwarded-host')
+  t.assert.strictEqual(request.port, null, 'port is not taken from the host header')
+})
+
+test('trust proxy does not take port from untrusted x-forwarded-host', t => {
+  t.plan(3)
+
+  const req = {
+    method: 'GET',
+    url: '/',
+    socket: { remoteAddress: '1.1.1.1' },
+    headers: {
+      host: 'real.test:8080',
+      'x-forwarded-host': 'spoofed.test:4567'
+    }
+  }
+
+  const TpRequest = buildRequest(Request, '10.0.0.1')
+  const request = new TpRequest('id', 'params', req, 'query', 'log')
+  t.assert.strictEqual(request.host, 'real.test:8080', 'falls back to host header')
+  t.assert.strictEqual(request.hostname, 'real.test', 'hostname falls back to host header')
+  t.assert.strictEqual(request.port, 8080, 'port falls back to host header')
+})
+
+test('trust proxy derives port from :authority when there is no host header', t => {
+  t.plan(3)
+
+  const req = {
+    method: 'GET',
+    url: '/',
+    socket: { remoteAddress: '1.1.1.1' },
+    headers: {
+      ':authority': 'fastify.test:4567'
+    }
+  }
+
+  const TpRequest = buildRequest(Request, true)
+  const request = new TpRequest('id', 'params', req, 'query', 'log')
+  t.assert.strictEqual(request.host, 'fastify.test:4567', 'gets host from :authority')
+  t.assert.strictEqual(request.hostname, 'fastify.test', 'gets hostname from :authority')
+  t.assert.strictEqual(request.port, 4567, 'gets port from :authority')
+})
+
+test('trust proxy port is null when there is no host source', t => {
+  t.plan(3)
+
+  const req = {
