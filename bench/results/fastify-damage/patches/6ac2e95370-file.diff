+test('trust proxy keeps host, hostname and port aligned', async t => {
+  t.plan(6)
+
+  const app = fastify({
+    trustProxy: (address) => address === localhost
+  })
+  t.after(() => app.close())
+
+  app.get('/withport', function (req, reply) {
+    t.assert.strictEqual(req.host, 'example.com:8080', 'host reads x-forwarded-host')
+    t.assert.strictEqual(req.hostname, 'example.com', 'hostname is the host without the port')
+    t.assert.strictEqual(req.port, 8080, 'port comes from x-forwarded-host, not the Host header')
+    reply.code(200).send({})
+  })
+
+  app.get('/ipv6withport', function (req, reply) {
+    t.assert.strictEqual(req.host, '[::1]:8080', 'host reads IPv6 x-forwarded-host')
+    t.assert.strictEqual(req.hostname, '[::1]', 'hostname keeps the IPv6 brackets')
+    t.assert.strictEqual(req.port, 8080, 'port is parsed after the IPv6 brackets')
+    reply.code(200).send({})
+  })
+
+  const fastifyServer = await app.listen({ port: 0 })
+
+  await fetch(fastifyServer + '/withport', {
+    headers: { 'X-Forwarded-Host': 'example.com:8080' }
+  })
+  await fetch(fastifyServer + '/ipv6withport', {
+    headers: { 'X-Forwarded-Host': '[::1]:8080' }
+  })
+})
+
