+
+test('.port is derived from .host when trustProxy is enabled', (t) => {
+  const fixtures = [
+    {
+      name: 'x-forwarded-host with a port wins over the Host header',
+      expectedHost: 'example.com:8080',
+      expectedHostname: 'example.com',
+      expectedPort: 8080,
+      headers: {
+        host: 'localhost:3000',
+        'x-forwarded-host': 'example.com:8080'
+      }
+    },
+    {
+      name: 'x-forwarded-host without a port yields a null port',
+      expectedHost: 'example.com',
+      expectedHostname: 'example.com',
+      expectedPort: null,
+      headers: {
+        host: 'localhost:3000',
+        'x-forwarded-host': 'example.com'
+      }
+    },
+    {
+      name: 'the last x-forwarded-host entry is used',
+      expectedHost: 'example.com:8080',
+      expectedHostname: 'example.com',
+      expectedPort: 8080,
+      headers: {
+        host: 'localhost:3000',
+        'x-forwarded-host': 'first.com:1111, example.com:8080'
+      }
+    },
+    {
+      name: 'IPv6 x-forwarded-host with a port',
+      expectedHost: '[::1]:8080',
+      expectedHostname: '[::1]',
+      expectedPort: 8080,
+      headers: {
+        host: 'localhost:3000',
+        'x-forwarded-host': '[::1]:8080'
+      }
+    },
+    {
+      name: 'falls back to the Host header without x-forwarded-host',
+      expectedHost: 'localhost:3000',
+      expectedHostname: 'localhost',
+      expectedPort: 3000,
+      headers: {
+        host: 'localhost:3000'
+      }
+    },
+    {
+      name: 'falls back to :authority without host or x-forwarded-host',
+      expectedHost: '1.2.3.4:8080',
+      expectedHostname: '1.2.3.4',
+      expectedPort: 8080,
+      headers: {
+        ':authority': '1.2.3.4:8080'
+      }
+    },
+    {
+      name: 'x-forwarded-host wins over :authority',
+      expectedHost: 'example.com:8080',
+      expectedHostname: 'example.com',
+      expectedPort: 8080,
+      headers: {
+        ':authority': '1.2.3.4:3000',
+        'x-forwarded-host': 'example.com:8080'
+      }
+    },
+    {
+      name: 'no host information at all yields a null port',
+      expectedHost: '',
+      expectedHostname: '',
+      expectedPort: null,
+      headers: {}
+    }
+  ]
+
+  // `true` trusts every proxy, so the forwarded headers are always honoured
+  const TpRequest = Request.buildRequest(Request, true)
+
+  for (const fixture of fixtures) {
+    const req = new TpRequest(1, {}, {
+      socket: { remoteAddress: 'ip' },
+      headers: fixture.headers
+    }, '', {}, {})
+
+    t.assert.strictEqual(req.host, fixture.expectedHost, `host: ${fixture.name}`)
+    t.assert.strictEqual(req.hostname, fixture.expectedHostname, `hostname: ${fixture.name}`)
+    t.assert.strictEqual(req.port, fixture.expectedPort, `port: ${fixture.name}`)
+  }
+})
+
+test('.port ignores x-forwarded-host from an untrusted connection', (t) => {
+  // Only 10.0.0.1 is trusted, the request comes from somewhere else
+  const TpRequest = Request.buildRequest(Request, '10.0.0.1')
+
+  const req = new TpRequest(1, {}, {
+    socket: { remoteAddress: '127.0.0.1' },
+    headers: {
+      host: 'localhost:3000',
+      'x-forwarded-host': 'evil.com:8080'
+    }
+  }, '', {}, {})
+
+  t.assert.strictEqual(req.host, 'localhost:3000')
+  t.assert.strictEqual(req.hostname, 'localhost')
+  t.assert.strictEqual(req.port, 3000)
+})
