+// A connection served over a pipe (e.g. iisnode, or a unix socket behind
+// nginx) has no `remoteAddress` on its socket. Hop count trusts by position,
+// so the forwarded address must still be resolved.
+test('trust proxy number over a socket without a remote address', { skip: process.platform === 'win32' ? 'unix sockets are not available' : false }, async t => {
+  t.plan(3)
+  const app = fastify({
+    trustProxy: 1
+  })
+  const socketPath = path.join(os.tmpdir(), `fastify-trust-proxy-${process.pid}.sock`)
+  t.after(() => app.close())
+
+  app.get('/trustproxynumber', function (req, reply) {
+    t.assert.strictEqual(req.socket.remoteAddress, undefined, 'the socket has no remote address')
+    t.assert.strictEqual(req.ip, '1.1.1.1', 'gets ip from x-forwarded-for')
+    t.assert.strictEqual(req.host, 'fastify.test', 'gets host from x-forwarded-host')
+    reply.code(200).send({ ip: req.ip, host: req.host })
+  })
+
+  await app.listen({ path: socketPath })
+
+  await new Promise((resolve, reject) => {
+    const req = http.request({
+      socketPath,
+      path: '/trustproxynumber',
+      headers: {
+        'X-Forwarded-For': '2.2.2.2, 1.1.1.1',
+        'X-Forwarded-Host': 'fastify.test'
+      }
+    }, res => {
+      res.resume()
+      res.on('end', resolve)
+    })
+    req.on('error', reject)
+    req.end()
+  })
+})
+
