+test('trust proxy - port comes from x-forwarded-host when it carries one', async t => {
+  t.plan(3)
+
+  const app = fastify({
+    trustProxy: true
+  })
+  t.after(() => app.close())
+
+  app.get('/forwardedport', function (req, reply) {
+    t.assert.strictEqual(req.host, 'fastify.test:8080')
+    t.assert.strictEqual(req.hostname, 'fastify.test')
+    t.assert.strictEqual(req.port, 8080)
+    reply.code(200).send({ port: req.port })
+  })
+
+  const fastifyServer = await app.listen({ port: 0 })
+
+  await fetch(fastifyServer + '/forwardedport', {
+    headers: {
+      'X-Forwarded-For': '1.1.1.1',
+      'X-Forwarded-Host': 'fastify.test:8080'
+    }
+  })
+})
+
+test('trust proxy - port falls back to the Host header from an untrusted connection', async t => {
+  t.plan(2)
+
+  // localhost is not in the trust list, so x-forwarded-host must be ignored
+  const app = fastify({
+    trustProxy: '10.0.0.1'
+  })
+  t.after(() => app.close())
+
+  app.get('/untrustedport', function (req, reply) {
+    t.assert.notStrictEqual(req.host, 'evil.com:8080')
+    t.assert.strictEqual(req.port, app.server.address().port)
+    reply.code(200).send({ port: req.port })
+  })
+
+  const fastifyServer = await app.listen({ port: 0 })
+
+  await fetch(fastifyServer + '/untrustedport', {
+    headers: {
+      'X-Forwarded-For': '1.1.1.1',
+      'X-Forwarded-Host': 'evil.com:8080'
+    }
+  })
+})
