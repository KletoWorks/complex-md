+
+test('.port is derived from .host when trustProxy is enabled', (t) => {
+  const fixtures = [
+    {
+      name: 'x-forwarded-host wins over host',
+      expected: 8080,
+      headers: {
+        'x-forwarded-host': 'fastify.test:8080',
+        host: 'example.com:80'
+      }
+    },
+    {
+      name: 'x-forwarded-host without a port yields null',
+      expected: null,
+      headers: {
+        'x-forwarded-host': 'fastify.test',
+        host: 'example.com:80'
+      }
+    },
+    {
+      name: 'last entry of a multi-value x-forwarded-host is used',
+      expected: 443,
+      headers: {
+        'x-forwarded-host': 'example2.com:80, fastify.test:443'
+      }
+    },
+    {
+      name: 'IPv6 x-forwarded-host',
+      expected: 8080,
+      headers: {
+        'x-forwarded-host': '[::1]:8080'
+      }
+    },
+    {
+      name: 'falls back to host without x-forwarded-host',
+      expected: 80,
+      headers: {
+        host: 'example.com:80'
+      }
+    },
+    {
+      name: 'falls back to :authority without x-forwarded-host or host',
+      expected: 8080,
+      headers: {
+        ':authority': '1.2.3.4:8080'
+      }
+    },
+    {
+      name: 'no host information at all yields null',
+      expected: null,
+      headers: {}
+    }
+  ]
+
+  const TpRequest = Request.buildRequest(Request, true)
+
+  for (const fixture of fixtures) {
+    const raw = {
+      method: 'GET',
+      url: '/',
+      socket: { remoteAddress: 'ip' },
+      headers: fixture.headers
+    }
+    const req = new TpRequest(1, {}, raw, '', {}, {})
+    t.assert.equal(req.port, fixture.expected, fixture.name)
+    // host, hostname and port must always agree on their source
+    t.assert.equal(
+      req.port === null ? req.host : `${req.hostname}:${req.port}`,
+      req.host,
+      `${fixture.name}: host, hostname and port agree`
+    )
+  }
+})
+
+test('.port ignores x-forwarded-host from an untrusted connection', (t) => {
+  const TpRequest = Request.buildRequest(Request, true)
+  const raw = {
+    method: 'GET',
+    url: '/',
+    socket: null,
+    headers: {
+      'x-forwarded-host': 'fastify.test:8080',
+      host: 'example.com:80'
+    }
+  }
+  const req = new TpRequest(1, {}, raw, '', {}, {})
+  t.assert.equal(req.host, 'example.com:80')
+  t.assert.equal(req.port, 80)
+})
