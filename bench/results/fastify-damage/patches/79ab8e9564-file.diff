+        const response = data.toString('utf-8')
+        t.assert.match(response, /^HTTP\/1.1 400 Bad Request/)
+        t.assert.deepStrictEqual(JSON.parse(response.slice(response.indexOf('\r\n\r\n') + 4)), {
+          error: 'Bad Request',
+          message: '\'/hello/%world"\\back\' is not a valid url component',
+          statusCode: 400,
+          code: 'FST_ERR_BAD_URL'
+        })
+        done()
+      })
+    })
+  })
