+  await t.test('The path is escaped in the JSON body', (t, done) => {
+    t.plan(3)
+    let data = Buffer.alloc(0)
+    const fastify = Fastify()
+
+    t.after(() => fastify.close())
+
+    fastify.get('/hello/:id', () => t.assert.fail('we should not be here'))
+    fastify.listen({ port: 0 }, err => {
+      t.assert.ifError(err)
+
+      // the double quote and the backslash would produce an invalid JSON
+      // body if they were interpolated as-is
+      const socket = connect(fastify.server.address().port)
+      socket.write('GET /hello/%world"\\back HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n')
+      socket.on('data', c => (data = Buffer.concat([data, c])))
