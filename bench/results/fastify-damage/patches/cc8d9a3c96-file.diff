diff --git a/test/decorator.test.js b/test/decorator.test.js
index 972658f9..100a7f03 100644
--- a/test/decorator.test.js
+++ b/test/decorator.test.js
@@ -1328,3 +1328,91 @@ test('Request.setDecorator should update an existing decorator', (t, done) => {
     })
   })
 })
+
+describe('constructor-assigned properties are visible to the decorator checks', () => {
+  const requestProperties = ['id', 'params', 'raw', 'query', 'log', 'body']
+  const replyProperties = ['raw', 'request', 'log']
+
+  test('hasRequestDecorator returns true for constructor-assigned properties', t => {
+    t.plan(requestProperties.length)
+    const fastify = Fastify()
+    for (const name of requestProperties) {
+      t.assert.ok(fastify.hasRequestDecorator(name), `request.${name}`)
+    }
+  })
+
+  test('hasReplyDecorator returns true for constructor-assigned properties', t => {
+    t.plan(replyProperties.length)
+    const fastify = Fastify()
+    for (const name of replyProperties) {
+      t.assert.ok(fastify.hasReplyDecorator(name), `reply.${name}`)
+    }
+  })
+
+  test('decorateRequest throws for constructor-assigned properties', t => {
+    t.plan(requestProperties.length)
+    const fastify = Fastify()
+    for (const name of requestProperties) {
+      t.assert.throws(
+        () => fastify.decorateRequest(name, null),
+        err => err.code === 'FST_ERR_DEC_ALREADY_PRESENT',
+        `request.${name}`
+      )
+    }
+  })
+
+  test('decorateReply throws for constructor-assigned properties', t => {
+    t.plan(replyProperties.length)
+    const fastify = Fastify()
+    for (const name of replyProperties) {
+      t.assert.throws(
+        () => fastify.decorateReply(name, null),
+        err => err.code === 'FST_ERR_DEC_ALREADY_PRESENT',
+        `reply.${name}`
+      )
+    }
+  })
+
+  test('the checks hold in an encapsulated context, where the constructors are derived', (t, done) => {
+    t.plan(5)
+    const fastify = Fastify()
+
+    fastify.register((instance, opts, next) => {
+      instance.decorateRequest('local', 'foo')
+      t.assert.ok(instance.hasRequestDecorator('id'))
+      t.assert.ok(instance.hasReplyDecorator('raw'))
+      t.assert.ok(instance.hasRequestDecorator('local'))
+      t.assert.throws(
+        () => instance.decorateRequest('id', null),
+        err => err.code === 'FST_ERR_DEC_ALREADY_PRESENT'
+      )
+      next()
+    })
+
+    fastify.ready(err => {
+      t.assert.ifError(err)
+      done()
+    })
+  })
+
+  test('unrelated names are still decoratable and reach the handler', (t, done) => {
+    t.plan(5)
+    const fastify = Fastify()
+    fastify.decorateRequest('myExtra', null)
+    fastify.decorateReply('myOtherExtra', null)
+
+    t.assert.ok(fastify.hasRequestDecorator('myExtra'))
+    t.assert.ok(fastify.hasReplyDecorator('myOtherExtra'))
+
+    fastify.get('/', (req, reply) => {
+      t.assert.strictEqual(req.myExtra, null)
+      t.assert.strictEqual(reply.myOtherExtra, null)
+      reply.send({ hello: 'world' })
+    })
+
+    fastify.inject({ url: '/' }, (err, res) => {
+      t.assert.ifError(err)
+      done()
+    })
+  })
+})
