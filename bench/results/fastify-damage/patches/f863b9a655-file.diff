diff --git a/test/internals/errors.test.js b/test/internals/errors.test.js
index f5930d6c..3d129e8b 100644
--- a/test/internals/errors.test.js
+++ b/test/internals/errors.test.js
@@ -931,3 +931,30 @@ test('Ensure that non-existing errors are not in Errors.md documented', t => {
     t.assert.ok(exportedKeys.indexOf(match[1]) !== -1, match[1])
   }
 })
+
+test('Ensure that all errors are in types/errors.d.ts', t => {
+  t.plan(expectedErrors)
+
+  const errorsTypes = readFileSync(resolve(__dirname, '../../types/errors.d.ts'), 'utf8')
+
+  const exportedKeys = Object.keys(errors)
+  for (const key of exportedKeys) {
+    if (errors[key].name === 'FastifyError') {
+      t.assert.ok(errorsTypes.includes(`'${key}'`), key)
+    }
+  }
+})
+
+test('Ensure that non-existing errors are not in types/errors.d.ts', t => {
+  const errorsTypes = readFileSync(resolve(__dirname, '../../types/errors.d.ts'), 'utf8')
+
+  const matchRE = /'(FST_ERR_[0-9A-Z_]+)'/g
+  const matches = [...errorsTypes.matchAll(matchRE)]
+  const exportedKeys = Object.keys(errors)
+
+  t.plan(matches.length)
+
+  for (const match of matches) {
+    t.assert.ok(exportedKeys.indexOf(match[1]) !== -1, match[1])
+  }
+})
