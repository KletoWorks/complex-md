+/**
+ * Gracefully closes the HTTP/2 sessions tracked on the given server, if any.
+ * An open session keeps the server open, so the sessions must be closed for
+ * `server.close()` to be able to complete.
+ *
+ * @param {object} server An HTTP/2 server instance created by
+ * `getServerInstance`. Servers of any other kind are ignored.
+ */
+function closeHttp2Sessions (server) {
+  const sessions = server[kHttp2Sessions]
+  if (sessions === undefined) {
+    return
+  }
+
+  // Sessions remove themselves from the map when they emit 'close'.
+  for (const session of sessions.values()) {
+    session.close()
+  }
+}
