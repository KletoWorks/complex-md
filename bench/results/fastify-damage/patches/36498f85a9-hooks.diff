+test('http/2 idle sessions are closed by fastify.close()', async t => {
+  const fastify = Fastify({ http2: true })
+
+  fastify.get('/', async () => ({}))
+
+  await fastify.listen({ port: 0 })
+
+  const sessions = fastify.server[kHttp2Sessions]
+
+  const url = getServerUrl(fastify)
+  const session = await connect(url)
+  // An error might or might not happen, as it's OS dependent.
+  session.on('error', () => {})
+
+  const req = session.request({
+    ':method': 'GET',
+    ':path': '/'
+  }).end()
+  const [headers] = await once(req, 'response')
+  t.assert.strictEqual(headers[':status'], 200)
+  req.resume()
+  await once(req, 'end')
+
+  t.assert.strictEqual(sessions.size, 1, 'the session is tracked while open')
+
+  // The session is idle but still open: without closing it the server would
+  // never finish closing. See https://github.com/fastify/fastify/issues/5716
+  const clientSessionClosed = once(session, 'close')
+  await fastify.close()
+  await clientSessionClosed
+  t.assert.ok(session.closed || session.destroyed)
+})
+
+test('http/2 sessions closed by the client are not retained', async t => {
+  const fastify = Fastify({ http2: true })
+
+  t.after(() => fastify.close())
+
+  await fastify.listen({ port: 0 })
+
+  const sessions = fastify.server[kHttp2Sessions]
+
+  const url = getServerUrl(fastify)
+  const session = await connect(url)
+  // An error might or might not happen, as it's OS dependent.
+  session.on('error', () => {})
+  t.assert.strictEqual(sessions.size, 1)
+
+  const serverSession = sessions.values().next().value
+  session.close()
+  await once(serverSession, 'close')
+  t.assert.strictEqual(sessions.size, 0, 'the closed session is removed from the map')
+})
