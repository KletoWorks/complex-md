+// A single large write on an HTTP/2 stream cannot be cancelled: if the client
+// resets the stream while the write is in flight, the data stays queued on the
+// session and the streams that follow on it stall. Payloads bigger than this
+// are written one chunk at a time so that at most one chunk is in flight and
+// we can stop as soon as the stream goes away. The size matches the default
+// HTTP/2 stream window, so well-behaved responses still take a single write.
+const HTTP2_CHUNK_SIZE = 65536
 const {
   FST_ERR_REP_INVALID_PAYLOAD_TYPE,
   FST_ERR_REP_RESPONSE_BODY_CONSUMED,
@@ -676,12 +683,56 @@ function onSendEnd (reply, payload) {
