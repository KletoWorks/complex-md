   safeWriteHead(reply, statusCode)
+
+  // only an Http2ServerResponse wraps an HTTP/2 stream, an HTTP/1 response
+  // served by an `allowHTTP1` server does not
+  const http2Stream = res.stream
+  if (http2Stream !== undefined && Buffer.byteLength(payload) > HTTP2_CHUNK_SIZE) {
+    // trailers are sent once the whole payload has been written
+    sendChunked(payload, http2Stream, res, reply)
