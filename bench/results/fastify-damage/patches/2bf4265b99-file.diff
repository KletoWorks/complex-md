   res.write(payload)
   // then send trailers
   sendTrailer(payload, res, reply)
 }
 
+/**
+ * Writes the payload in HTTP2_CHUNK_SIZE chunks, waiting for the socket to
+ * drain in between, then sends the trailers. Bails out without ending the
+ * response when the stream has already been destroyed by the client.
+ */
+function sendChunked (payload, http2Stream, res, reply) {
+  // a string is converted upfront: slicing it could split a surrogate pair
+  // across two chunks and each chunk is encoded on its own
+  const buffer = Buffer.isBuffer(payload) ? payload : Buffer.from(payload)
+  let offset = 0
+
+  function writeChunks () {
+    while (offset < buffer.length) {
+      // the client may have cancelled the stream, stop feeding the session.
+      // Http2ServerResponse does not expose `destroyed`, only the stream it
+      // wraps reports that the client has reset it
+      if (http2Stream.destroyed || res.writableEnded) return
+
+      const end = offset + HTTP2_CHUNK_SIZE
+      const flushed = res.write(buffer.subarray(offset, end))
+      offset = end
+
+      if (flushed === false && offset < buffer.length) {
+        res.once('drain', writeChunks)
+        return
+      }
+    }
+
+    sendTrailer(payload, res, reply)
+  }
+
+  writeChunks()
+}
