diff --git a/test/http2/plain.test.js b/test/http2/plain.test.js
index 3e1d5b4c..3c60c1a1 100644
--- a/test/http2/plain.test.js
+++ b/test/http2/plain.test.js
@@ -1,6 +1,7 @@
 'use strict'
 
 const { test } = require('node:test')
+const http2 = require('node:http2')
 const Fastify = require('../..')
 const h2url = require('h2url')
 const msg = { hello: 'world' }
@@ -66,3 +67,66 @@ test('http2 plain test', async t => {
     t.assert.strictEqual(JSON.parse(res.body).port, parseInt(host.split(':')[1]))
   })
 })
+
+test('http2 sends a large buffer payload in full', async t => {
+  t.plan(3)
+
+  // larger than the chunk size the reply is split into
+  const payload = Buffer.alloc(5 * 1024 * 1024, 'a')
+
+  const fastify = Fastify({ http2: true })
+  fastify.get('/', function (req, reply) {
+    reply.type('application/octet-stream').send(payload)
+  })
+
+  t.after(() => fastify.close())
+  await fastify.listen({ port: 0 })
+
+  const url = `http://localhost:${fastify.server.address().port}`
+  const res = await h2url.concat({ url })
+
+  t.assert.strictEqual(res.headers[':status'], 200)
+  t.assert.strictEqual(res.headers['content-length'], '' + payload.length)
+  t.assert.strictEqual(Buffer.byteLength(res.body), payload.length)
+})
+
+test('http2 keeps the session usable when a large payload is cancelled', async t => {
+  t.plan(2)
+
+  const payload = Buffer.alloc(20 * 1024 * 1024, 'a')
+
+  const fastify = Fastify({ http2: true })
+  fastify.get('/big', function (req, reply) {
+    reply.type('application/octet-stream').send(payload)
+  })
+  fastify.get('/small', function (req, reply) {
+    reply.send(msg)
+  })
+
+  t.after(() => fastify.close())
+  await fastify.listen({ port: 0 })
+
+  const session = http2.connect(`http://localhost:${fastify.server.address().port}`)
+  t.after(() => session.close())
+
+  // cancel the big reply as soon as the first bytes arrive
+  await new Promise((resolve, reject) => {
+    const req = session.request({ ':path': '/big' })
+    req.on('data', () => req.close(http2.constants.NGHTTP2_CANCEL))
+    req.on('error', reject)
+    req.on('close', resolve)
+  })
+
+  // the session must still be able to serve the requests that follow
+  const body = await new Promise((resolve, reject) => {
+    const req = session.request({ ':path': '/small' })
+    let data = ''
+    req.setEncoding('utf8')
+    req.on('data', chunk => { data += chunk })
+    req.on('error', reject)
+    req.on('end', () => resolve(data))
+  })
+
+  t.assert.ok(!session.destroyed, 'the session is still open')
+  t.assert.deepStrictEqual(JSON.parse(body), msg)
+})
