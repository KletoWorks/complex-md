diff --git a/lib/reply.js b/lib/reply.js
index 38d2ca97..80ffdc12 100644
--- a/lib/reply.js
+++ b/lib/reply.js
@@ -44,6 +44,13 @@ const CONTENT_TYPE = {
   PLAIN: 'text/plain; charset=utf-8',
   OCTET: 'application/octet-stream'
