+// The `x-forwarded-*` headers must only be used when the request comes
+// from a proxy the user asked us to trust, otherwise any client could
+// forge them.
+function isTrustedProxy (request, proxyFn) {
+  // A `null` proxyFn means `trustProxy: true`, every proxy is trusted
+  if (proxyFn === null) {
+    return true
+  }
+  const remoteAddress = request.socket?.remoteAddress
+  // Without a remote address there is no way to tell if the connection
+  // comes from a trusted proxy
+  if (remoteAddress === undefined) {
+    return false
+  }
+  return !!proxyFn(remoteAddress, 0)
+}
