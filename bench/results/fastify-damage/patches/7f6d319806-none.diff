+/**
+ * Releases the metadata that `onTimeout` hooks need (see lib/route.js), so the
+ * request, reply and route context are not retained for the whole socket
+ * lifetime. The socket 'timeout' listener is removed along with it: once the
+ * metadata is gone the listener has nothing to work with, and leaving it
+ * attached would also pile up a listener per request on keep-alive sockets.
+ */
+function clearSocketMeta (request) {
+  const socket = request.raw.socket
+  // Only the request that owns the metadata is allowed to clear it: on a
+  // keep-alive socket the next request may have already replaced it.
+  if (socket == null || socket._meta == null || socket._meta.request !== request) {
+    return
+  }
+
+  socket._meta = null
+
+  const onTimeoutListener = socket[kSocketOnTimeout]
+  if (onTimeoutListener !== undefined) {
+    socket[kSocketOnTimeout] = undefined
+    socket.removeListener('timeout', onTimeoutListener)
+  }
+}
