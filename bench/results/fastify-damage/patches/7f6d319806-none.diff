+test('socket._meta is cleared on reply.hijack() when onTimeout is registered', async t => {
+  t.plan(4)
+  const fastify = Fastify({ connectionTimeout: 500 })
+  t.after(() => { fastify.close() })
+
+  fastify.addHook('onTimeout', function (req, reply, done) { done() })
+
+  fastify.get('/', async function (req, reply) {
+    // yield once, so the route has attached socket._meta before we hijack
+    await Promise.resolve()
+    const metaWhileInFlight = req.raw.socket._meta
+    reply.hijack()
+    const metaAfterHijack = req.raw.socket._meta
+
+    // answer before asserting, so a failure does not hang the client
+    reply.raw.writeHead(200, { 'content-type': 'application/json' })
+    reply.raw.end(JSON.stringify({ hello: 'world' }))
+
+    t.assert.ok(metaWhileInFlight, 'socket._meta is set while the request is in flight')
+    t.assert.strictEqual(metaAfterHijack, null, 'socket._meta must be null after hijack')
+  })
+
+  const address = await fastify.listen({ port: 0 })
+  const result = await fetch(address)
+  t.assert.ok(result.ok)
+  t.assert.deepStrictEqual(await result.json(), { hello: 'world' })
+})
+
