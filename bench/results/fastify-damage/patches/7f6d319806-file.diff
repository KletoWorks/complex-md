+test('socket._meta is cleared on reply.hijack() when onTimeout is registered', async t => {
+  t.plan(6)
+  const fastify = Fastify({ connectionTimeout: 500 })
+  t.after(() => { fastify.close() })
+
+  fastify.addHook('onTimeout', function (req, res, done) { done() })
+
+  // A hijacked reply never emits 'finish', so onResFinished never runs and the
+  // metadata must be released by hijack() itself.
+  let syncSocket = null
+  fastify.get('/sync', (req, reply) => {
+    syncSocket = req.raw.socket
+    reply.hijack()
+    reply.raw.writeHead(200, { 'content-length': 2 })
+    reply.raw.end('ok')
+  })
+
+  let asyncSocket = null
+  fastify.get('/async', async (req, reply) => {
+    asyncSocket = req.raw.socket
+    await sleep(10)
+    t.assert.strictEqual(asyncSocket._meta.request, req, 'metadata is armed before hijack')
+    reply.hijack()
+    reply.raw.writeHead(200, { 'content-length': 2 })
+    reply.raw.end('ok')
+  })
+
+  const address = await fastify.listen({ port: 0 })
+
+  const syncRes = await fetch(address + '/sync')
+  t.assert.strictEqual(await syncRes.text(), 'ok')
+  t.assert.ok(!syncSocket._meta, 'socket._meta must not retain a hijacked request/reply')
+
+  const asyncRes = await fetch(address + '/async')
+  t.assert.strictEqual(await asyncRes.text(), 'ok')
+  t.assert.strictEqual(asyncSocket._meta, null, 'socket._meta must be cleared by hijack()')
+
+  // The 'timeout' listener outlives the request; it must tolerate the released
+  // metadata instead of throwing on a null _meta.
+  t.assert.doesNotThrow(() => asyncSocket.emit('timeout'))
+})
+
+test('onTimeout socket listener is attached once per keep-alive socket', async t => {
+  t.plan(3)
+  const fastify = Fastify()
+  t.after(() => { fastify.close() })
+
+  fastify.addHook('onTimeout', function (req, res, done) { done() })
+  fastify.addHook('onResponse', function (req, reply, done) { done() })
+
+  let socket = null
+  fastify.get('/', async (req) => {
+    socket = req.raw.socket
+    return { hello: 'world' }
+  })
+
+  const address = await fastify.listen({ port: 0 })
+  const { port } = new URL(address)
+
+  const client = connect(port, '127.0.0.1')
+  t.after(() => { client.destroy() })
+  client.on('error', () => {})
+  await new Promise(resolve => client.once('connect', resolve))
+
+  const counts = []
+  for (let i = 0; i < 3; i++) {
+    client.write('GET / HTTP/1.1\r\nHost: x\r\nConnection: keep-alive\r\n\r\n')
+    await new Promise(resolve => client.once('data', resolve))
+    counts.push(socket.listenerCount('timeout'))
+  }
+
+  t.assert.strictEqual(counts[0], counts[1], 'no listener added on the second request')
+  t.assert.strictEqual(counts[1], counts[2], 'no listener added on the third request')
+  t.assert.strictEqual(socket._meta, null, 'socket._meta is released between requests')
+})
+
