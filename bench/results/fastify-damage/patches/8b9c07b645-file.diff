+    // Release the references the socket holds to this request: on a keep-alive
+    // connection `_meta` would otherwise keep the context, request and reply
+    // alive for the whole lifetime of the socket. The ownership check leaves
+    // alone a `_meta` that a later request already replaced. It is reset to
+    // `null` rather than removed so that `lib/route.js` can tell that the
+    // socket already has its `timeout` listener attached.
+    const socket = reply.request.raw.socket
+    if (socket?._meta?.request === reply.request) {
+      socket._meta = null
+    }
