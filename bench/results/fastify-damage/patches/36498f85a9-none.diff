+/**
+ * Closes every http2 session tracked for the given server, if any.
+ * Sessions keep `server.close` from completing, so they must be
+ * closed on shutdown.
+ *
+ * @param {import('node:http2').Http2Server} server
+ * @param {boolean} force When true the sessions are destroyed instead of
+ * being gracefully closed.
+ */
+function closeHttp2Sessions (server, force) {
+  const sessions = server[kHttp2Sessions]
+  if (sessions === undefined) return
+
+  for (const session of sessions.values()) {
+    if (force) {
+      session.destroy()
+    } else {
+      session.close()
+    }
+  }
+  sessions.clear()
+}
