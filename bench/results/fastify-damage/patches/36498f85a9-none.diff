+test('http/2 sessions are tracked and closed on fastify.close()', async t => {
+  const fastify = Fastify({
+    http2: true
+  })
+
+  fastify.get('/', async () => ({}))
+
+  await fastify.listen({ port: 0 })
+
+  const url = getServerUrl(fastify)
+  const session = await connect(url)
+  // An error might or might not happen, as it's OS dependent.
+  session.on('error', () => {})
+
+  // the request makes sure the server has seen the session
+  const req = session.request({
+    ':method': 'GET',
+    ':path': '/'
+  }).end()
+  const [headers] = await once(req, 'response')
+  t.assert.strictEqual(headers[':status'], 200)
+  req.resume()
+
+  t.assert.strictEqual(fastify.server[kHttp2Sessions].size, 1)
+
+  const sessionClosed = once(session, 'close')
+  // the default `http2SessionTimeout` is used, so the session would
+  // stay open for a long time if `close` did not take care of it
+  await fastify.close()
+  await sessionClosed
+
+  t.assert.strictEqual(fastify.server[kHttp2Sessions].size, 0)
+})
+
+test('http/2 sessions are destroyed on fastify.close() with forceCloseConnections', async t => {
+  const fastify = Fastify({
+    http2: true,
+    forceCloseConnections: true
+  })
+
+  fastify.get('/', async () => ({}))
+
+  await fastify.listen({ port: 0 })
+
+  const url = getServerUrl(fastify)
+  const session = await connect(url)
+  // An error might or might not happen, as it's OS dependent.
+  session.on('error', () => {})
+
+  const sessionClosed = once(session, 'close')
+  await fastify.close()
+  await sessionClosed
+
+  t.assert.strictEqual(fastify.server[kHttp2Sessions].size, 0)
+})
+
+test('http/2 sessions are removed from the tracking map when closed by the client', async t => {
+  const fastify = Fastify({
+    http2: true
+  })
+
+  fastify.get('/', async () => ({}))
+
+  t.after(() => fastify.close())
+
+  await fastify.listen({ port: 0 })
+
+  const url = getServerUrl(fastify)
+  const session = await connect(url)
+  // An error might or might not happen, as it's OS dependent.
+  session.on('error', () => {})
+
+  const req = session.request({
+    ':method': 'GET',
+    ':path': '/'
+  }).end()
+  await once(req, 'response')
+  req.resume()
+
+  t.assert.strictEqual(fastify.server[kHttp2Sessions].size, 1)
+
+  session.close()
+  await once(session, 'close')
+
+  // the server side session is closed asynchronously
+  while (fastify.server[kHttp2Sessions].size > 0) {
+    await new Promise(resolve => setTimeout(resolve, 10))
+  }
+
+  t.assert.strictEqual(fastify.server[kHttp2Sessions].size, 0)
+})
