     querystringParser?: (str: string) => { [key: string]: unknown },
     useSemicolonDelimiter?: boolean,
   }
diff --git a/test/types/fastify.test-d.ts b/test/types/fastify.test-d.ts
index 17740b5b..b59db227 100644
--- a/test/types/fastify.test-d.ts
+++ b/test/types/fastify.test-d.ts
@@ -17,6 +17,7 @@ import fastify, {
   LightMyRequestCallback,
   LightMyRequestChain,
   LightMyRequestResponse,
+  RawReplyDefaultExpression,
   RawRequestDefaultExpression,
   RouteGenericInterface,
   SafePromiseLike
@@ -184,6 +185,39 @@ expectAssignable<FastifyInstance>(fastify({
   }
 }))
 expectAssignable<FastifyInstance>(fastify({ trustProxy: true }))
+expectAssignable<FastifyInstance>(fastify({
+  routerOptions: {
+    defaultRoute: (req, res) => {
+      expectType<RawRequestDefaultExpression>(req)
+      expectType<RawReplyDefaultExpression>(res)
+      res.statusCode = 404
+      res.end()
+    },
+    onBadUrl: (path, req, res) => {
+      expectType<string>(path)
+      expectType<RawRequestDefaultExpression>(req)
+      expectType<RawReplyDefaultExpression>(res)
+      res.statusCode = 400
+      res.end()
+    }
+  }
+}))
+// `defaultRoute` and `onBadUrl` receive the raw Node.js objects, so the
+// Fastify Reply decorators are not available on them
+expectError(fastify({
+  routerOptions: {
+    defaultRoute: (req, res) => {
+      res.send({ hello: 'world' })
+    }
+  }
+}))
+expectError(fastify({
+  routerOptions: {
+    onBadUrl: (path, req, res) => {
+      res.send({ hello: 'world' })
+    }
+  }
+}))
 expectAssignable<FastifyInstance>(fastify({ querystringParser: () => ({ foo: 'bar' }) }))
 expectAssignable<FastifyInstance>(fastify({ querystringParser: () => ({ foo: { bar: 'fuzz' } }) }))
 expectAssignable<FastifyInstance>(fastify({ querystringParser: () => ({ foo: ['bar', 'fuzz'] }) }))
