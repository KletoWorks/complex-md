+test('Should not mutate the user provided routerOptions object', async t => {
+  t.plan(2)
+  const routerOptions = { maxParamLength: 2048 }
+  const options = { routerOptions }
+
+  const fastify = Fastify(options)
+  t.after(() => fastify.close())
+
+  await fastify.ready()
+
+  t.assert.deepStrictEqual(Object.keys(routerOptions), ['maxParamLength'])
+  t.assert.strictEqual(options.routerOptions, routerOptions)
+})
+
+test('Should allow reusing the same options object on multiple instances', async t => {
+  t.plan(4)
+  const options = { routerOptions: { maxParamLength: 2048 } }
+
+  const first = Fastify(options)
+  t.after(() => first.close())
+
+  const second = Fastify(options)
+  t.after(() => second.close())
+
+  second.get('/test', (req, reply) => {
+    reply.send('test')
+  })
+
+  let res = await second.inject('/test')
+  t.assert.strictEqual(res.statusCode, 200)
+  t.assert.strictEqual(res.payload.toString(), 'test')
+
+  // the 404 must be handled by the second instance, not by the first one
+  res = await second.inject('/not-here')
+  t.assert.strictEqual(res.statusCode, 404)
+  t.assert.strictEqual(res.json().message, 'Route GET:/not-here not found')
+})
+
