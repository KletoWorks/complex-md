diff --git a/test/decorator.test.js b/test/decorator.test.js
index 972658f9..cf9a9266 100644
--- a/test/decorator.test.js
+++ b/test/decorator.test.js
@@ -1328,3 +1328,101 @@ test('Request.setDecorator should update an existing decorator', (t, done) => {
     })
   })
 })
+
+describe('constructor-assigned properties', () => {
+  const requestProperties = ['id', 'params', 'raw', 'query', 'log', 'body']
+  const replyProperties = ['raw', 'request', 'log']
+
+  test('hasRequestDecorator should find properties set in the Request constructor', t => {
+    t.plan(requestProperties.length)
+    const fastify = Fastify()
+
+    for (const property of requestProperties) {
+      t.assert.ok(fastify.hasRequestDecorator(property), `request has '${property}'`)
+    }
+  })
+
+  test('hasReplyDecorator should find properties set in the Reply constructor', t => {
+    t.plan(replyProperties.length)
+    const fastify = Fastify()
+
+    for (const property of replyProperties) {
+      t.assert.ok(fastify.hasReplyDecorator(property), `reply has '${property}'`)
+    }
+  })
+
+  test('decorateRequest should throw on properties set in the Request constructor', t => {
+    t.plan(requestProperties.length)
+    const fastify = Fastify()
+
+    for (const property of requestProperties) {
+      t.assert.throws(
+        () => fastify.decorateRequest(property, null),
+        err => err.code === 'FST_ERR_DEC_ALREADY_PRESENT',
+        `request '${property}' is already present`
+      )
+    }
+  })
+
+  test('decorateReply should throw on properties set in the Reply constructor', t => {
+    t.plan(replyProperties.length)
+    const fastify = Fastify()
+
+    for (const property of replyProperties) {
+      t.assert.throws(
+        () => fastify.decorateReply(property, null),
+        err => err.code === 'FST_ERR_DEC_ALREADY_PRESENT',
+        `reply '${property}' is already present`
+      )
+    }
+  })
+
+  test('constructor-assigned properties are found on derived constructors', (t, done) => {
+    t.plan(5)
+    const fastify = Fastify()
+
+    // decorating builds a derived Request/Reply for the encapsulated context
+    fastify.decorateRequest('sub', null)
+    fastify.decorateReply('sub', null)
+
+    fastify.register((instance, opts, next) => {
+      t.assert.ok(instance.hasRequestDecorator('id'))
+      t.assert.ok(instance.hasReplyDecorator('raw'))
+      t.assert.throws(
+        () => instance.decorateRequest('id', null),
+        err => err.code === 'FST_ERR_DEC_ALREADY_PRESENT'
+      )
+      t.assert.throws(
+        () => instance.decorateReply('raw', null),
+        err => err.code === 'FST_ERR_DEC_ALREADY_PRESENT'
+      )
+      next()
+    })
+
+    fastify.ready(err => {
+      t.assert.ifError(err)
+      done()
+    })
+  })
+
+  test('custom decorators are still allowed and do not break the request lifecycle', (t, done) => {
+    t.plan(4)
+    const fastify = Fastify()
+
+    fastify.decorateRequest('myExtra', null)
+    fastify.decorateReply('myOtherExtra', null)
+
+    t.assert.ok(fastify.hasRequestDecorator('myExtra'))
+    t.assert.ok(fastify.hasReplyDecorator('myOtherExtra'))
+
+    fastify.get('/', (req, reply) => {
+      reply.send({ id: req.id, myExtra: req.myExtra })
+    })
+
+    fastify.inject('/', (err, res) => {
+      t.assert.ifError(err)
+      t.assert.deepStrictEqual(JSON.parse(res.payload), { id: 'req-1', myExtra: null })
+      done()
+    })
+  })
+})
