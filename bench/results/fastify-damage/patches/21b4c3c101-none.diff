+test('trust proxy with ip list and missing socket remoteAddress', t => {
+  t.plan(6)
+
+  // An address based trust function cannot trust a missing socket address,
+  // whether it is undefined or null, so the proxy headers are ignored
+  for (const remoteAddress of [undefined, null]) {
+    const req = {
+      method: 'GET',
+      url: '/',
+      socket: { remoteAddress },
+      headers: {
+        host: 'fastify.local',
+        'x-forwarded-for': '2.2.2.2, 1.1.1.1',
+        'x-forwarded-host': 'fastify.test',
+        'x-forwarded-proto': 'https'
+      }
+    }
+
+    const TpRequest = buildRequest(Request, '127.0.0.1')
+    const request = new TpRequest('id', 'params', req, 'query', 'log')
+    t.assert.strictEqual(request.ip, remoteAddress, 'ip is the socket address')
+    t.assert.strictEqual(request.host, 'fastify.local', 'ignores x-forwarded-host')
+    t.assert.strictEqual(request.protocol, 'http', 'ignores x-forwarded-proto')
+  }
 })
