diff --git a/test/content-parser.test.js b/test/content-parser.test.js
index 83a75776..4ffcbaf1 100644
--- a/test/content-parser.test.js
+++ b/test/content-parser.test.js
@@ -730,3 +730,59 @@ test('edge case content-type - ;', async t => {
 
   t.assert.ok('end')
 })
+
+test('default json parser should return FST_ERR_CTP_INVALID_JSON_BODY on malformed body', async t => {
+  t.plan(3)
+
+  const fastify = Fastify()
+
+  fastify.post('/', () => {
+    t.assert.fail('handler should not be called')
+  })
+
+  const response = await fastify.inject({
+    method: 'POST',
+    path: '/',
+    headers: {
+      'content-type': 'application/json'
+    },
+    // the invalid part of the body must not be reflected back to the client
+    body: '{"hello":"<script>alert(1)</script>"'
+  })
+
+  t.assert.strictEqual(response.statusCode, 400)
+  t.assert.deepStrictEqual(response.json(), {
+    error: 'Bad Request',
+    code: 'FST_ERR_CTP_INVALID_JSON_BODY',
+    message: "Body is not valid JSON but content-type is set to 'application/json'",
+    statusCode: 400
+  })
+  t.assert.ok(!response.payload.includes('<script>'))
+})
+
+test('default json parser should keep the original error as cause', async t => {
+  t.plan(3)
+
+  const fastify = Fastify()
+
+  fastify.post('/', () => {
+    t.assert.fail('handler should not be called')
+  })
+
+  fastify.setErrorHandler((err, request, reply) => {
+    t.assert.strictEqual(err.code, 'FST_ERR_CTP_INVALID_JSON_BODY')
+    t.assert.ok(err.cause instanceof SyntaxError)
+    reply.send(err)
+  })
+
+  const response = await fastify.inject({
+    method: 'POST',
+    path: '/',
+    headers: {
+      'content-type': 'application/json'
+    },
+    body: '{"hello":'
+  })
+
+  t.assert.strictEqual(response.statusCode, 400)
+})
