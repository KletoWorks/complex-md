+// Counts the calls to closeIdleConnections made before server.close() is
+// invoked, so that the calls Node.js performs internally as part of
+// server.close() are not taken into account.
+function countCloseIdleConnections (server) {
+  const counter = { before: 0, calls: 0 }
+  const closeIdleConnections = server.closeIdleConnections.bind(server)
+  const close = server.close.bind(server)
+
+  server.closeIdleConnections = function () {
+    counter.calls++
+    return closeIdleConnections()
+  }
+  server.close = function (cb) {
+    counter.before = counter.calls
+    return close(cb)
+  }
+
+  return counter
+}
+
+test('does not call closeIdleConnections on a native server (idle)', { skip: noSupport }, async t => {
+  t.plan(1)
+
+  const fastify = Fastify({ forceCloseConnections: 'idle' })
+  const counter = countCloseIdleConnections(fastify.server)
+
+  await fastify.listen({ port: 0 })
+  await fastify.close()
+
+  // Native servers close idle connections as part of server.close()
+  t.assert.strictEqual(counter.before, 0)
+})
+
+test('calls closeIdleConnections on a serverFactory server (idle)', { skip: noSupport }, async t => {
+  t.plan(1)
+
+  const server = http.createServer()
+  const counter = countCloseIdleConnections(server)
+
+  const fastify = Fastify({
+    forceCloseConnections: 'idle',
+    serverFactory (handler) {
+      server.on('request', handler)
+      return server
+    }
+  })
+
+  await fastify.listen({ port: 0 })
+  await fastify.close()
+
+  t.assert.strictEqual(counter.before, 1)
+})
+
