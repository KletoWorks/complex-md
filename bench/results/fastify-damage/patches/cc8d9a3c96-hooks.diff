+describe('built-in properties assigned in the Request/Reply constructors', () => {
+  // these are set in the constructor body, never on the prototype
+  const requestProperties = ['id', 'params', 'raw', 'query', 'log', 'body']
+  const replyProperties = ['raw', 'request', 'log']
+
+  test('hasRequestDecorator should find them', async t => {
+    const fastify = Fastify()
+
+    for (const name of requestProperties) {
+      t.assert.strictEqual(fastify.hasRequestDecorator(name), true, name)
+    }
+  })
+
+  test('hasReplyDecorator should find them', async t => {
+    const fastify = Fastify()
+
+    for (const name of replyProperties) {
+      t.assert.strictEqual(fastify.hasReplyDecorator(name), true, name)
+    }
+  })
+
+  test('decorateRequest should refuse to overwrite them', async t => {
+    const fastify = Fastify()
+
+    for (const name of requestProperties) {
+      t.assert.throws(
+        () => fastify.decorateRequest(name, null),
+        err => err.code === 'FST_ERR_DEC_ALREADY_PRESENT',
+        name
+      )
+    }
+  })
+
+  test('decorateReply should refuse to overwrite them', async t => {
+    const fastify = Fastify()
+
+    for (const name of replyProperties) {
+      t.assert.throws(
+        () => fastify.decorateReply(name, null),
+        err => err.code === 'FST_ERR_DEC_ALREADY_PRESENT',
+        name
+      )
+    }
+  })
+
+  test('unrelated decorators are unaffected', async t => {
+    const fastify = Fastify()
+
+    fastify.decorateRequest('myExtra', null)
+    fastify.decorateReply('myExtra', null)
+
+    t.assert.strictEqual(fastify.hasRequestDecorator('myExtra'), true)
+    t.assert.strictEqual(fastify.hasReplyDecorator('myExtra'), true)
+    t.assert.strictEqual(fastify.hasRequestDecorator('notThere'), false)
+    t.assert.strictEqual(fastify.hasReplyDecorator('notThere'), false)
+  })
+
+  test('the derived per-route constructors inherit them', async t => {
+    const fastify = Fastify({ trustProxy: true })
+
+    fastify.decorateRequest('foo', 'bar')
+    fastify.decorateReply('foo', 'bar')
+
+    let scope
+    fastify.get('/', (req, reply) => {
+      // req.constructor is a subclass built by buildRequest, not Request itself
+      scope = {
+        [symbols.kRequest]: req.constructor,
+        [symbols.kReply]: reply.constructor
+      }
+      reply.send({})
+    })
+
+    await fastify.inject({ url: '/' })
+
+    // the subclasses carry no list of their own, so the lookup has to walk up
+    t.assert.ok(scope[symbols.kRequest].parent)
+    t.assert.ok(scope[symbols.kReply].parent)
+    t.assert.strictEqual(Object.hasOwn(scope[symbols.kRequest], 'instanceProperties'), false)
+    t.assert.strictEqual(Object.hasOwn(scope[symbols.kReply], 'instanceProperties'), false)
+
+    for (const name of requestProperties) {
+      t.assert.strictEqual(decorator.existRequest.call(scope, name), true, name)
+    }
+    for (const name of replyProperties) {
+      t.assert.strictEqual(decorator.existReply.call(scope, name), true, name)
+    }
+    t.assert.strictEqual(decorator.existRequest.call(scope, 'notThere'), false)
+    t.assert.strictEqual(decorator.existReply.call(scope, 'notThere'), false)
+  })
+})
+
