+// Properties assigned in the Request/Reply constructor body are not on the
+// prototype, so they are listed on the constructor instead. Derived
+// constructors built by buildRequest/buildReply inherit the list through
+// their `parent` chain.
+function hasInstanceProperty (konstructor, name) {
+  let current = konstructor
+  while (current) {
