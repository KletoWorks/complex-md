diff --git a/test/http-methods/custom-http-methods.test.js b/test/http-methods/custom-http-methods.test.js
index 61feed4e..0483d56e 100644
--- a/test/http-methods/custom-http-methods.test.js
+++ b/test/http-methods/custom-http-methods.test.js
@@ -112,3 +112,79 @@ test('addHttpMethod rejects fake http method', t => {
   const fastify = Fastify()
   t.assert.throws(() => { fastify.addHttpMethod('FOOO') }, /Provided method is invalid!/)
 })
+
+test('addHttpMethod does not override standard http methods', t => {
+  t.plan(6)
+  const fastify = Fastify()
+
+  t.assert.throws(
+    () => { fastify.addHttpMethod('GET', { hasBody: true }) },
+    {
+      code: 'FST_ERR_ROUTE_METHOD_ALREADY_SUPPORTED',
+      message: "GET method is already supported with a different body support. Use the 'override' option to change it."
+    }
+  )
+  t.assert.throws(
+    () => { fastify.addHttpMethod('POST') },
+    { code: 'FST_ERR_ROUTE_METHOD_ALREADY_SUPPORTED' }
+  )
+
+  // the supported methods are left untouched
+  t.assert.throws(() => {
+    fastify.route({
+      url: '/',
+      method: 'GET',
+      schema: { body: { type: 'object' } },
+      handler: function (req, reply) { reply.send(req.body) }
+    })
+  }, /Body validation schema for GET:\/ route is not supported!/)
+
+  t.assert.doesNotThrow(() => {
+    fastify.route({
+      url: '/',
+      method: 'POST',
+      schema: { body: { type: 'object' } },
+      handler: function (req, reply) { reply.send(req.body) }
+    })
+  })
+
+  // adding an already supported method without changing its body support is a no-op
+  t.assert.doesNotThrow(() => { fastify.addHttpMethod('GET') })
+  t.assert.doesNotThrow(() => { fastify.addHttpMethod('POST', { hasBody: true }) })
+})
+
+test('addHttpMethod overrides a supported http method when the override option is set', (t, done) => {
+  t.plan(3)
+  const fastify = Fastify()
+
+  fastify.addHttpMethod('GET', { hasBody: true, override: true })
+  t.assert.doesNotThrow(() => { addEcho(fastify, 'GET') })
+
+  fastify.inject({
+    method: 'GET',
+    url: '/',
+    payload: { hello: 'world' }
+  }, (err, response) => {
+    t.assert.ifError(err)
+    t.assert.deepStrictEqual(response.json(), { hello: 'world' })
+    done()
+  })
+})
+
+test('addHttpMethod can remove the body support of a custom method', t => {
+  t.plan(2)
+  const fastify = Fastify()
+
+  fastify.addHttpMethod('REBIND', { hasBody: true })
+  t.assert.ok(fastify.supportedMethods.includes('REBIND'))
+
+  fastify.addHttpMethod('REBIND', { override: true })
+  t.assert.throws(() => {
+    fastify.route({
+      url: '/',
+      method: 'REBIND',
+      schema: { body: { type: 'object' } },
+      handler: function (req, reply) { reply.send(req.body) }
+    })
+  }, /Body validation schema for REBIND:\/ route is not supported!/)
+})
