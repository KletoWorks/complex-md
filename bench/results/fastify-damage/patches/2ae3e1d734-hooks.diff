+/**
+ * Determines if a log level is known by the given logger, so that an invalid
+ * `logLevel` fails at registration time instead of crashing the first request
+ * that tries to build a child logger with it.
+ *
+ * Loggers that do not expose the `levels.values` map (the null logger or a
+ * custom one) cannot be checked, so their levels are left alone.
+ *
+ * @param {object} logger The logger the child logger will be created from.
+ * @param {string?} logLevel The level to validate.
+ *
+ * @throws {FST_ERR_LOG_INVALID_LOG_LEVEL} When the level is not supported.
+ */
+function validateLogLevel (logger, logLevel) {
+  // an empty level means "inherit from the parent logger"
+  if (!logLevel) {
+    return
+  }
+
+  const levels = logger?.levels?.values
+  if (levels === undefined) {
+    return
+  }
+
+  // 'silent' is not part of the levels map, but every pino logger accepts it
+  if (logLevel === 'silent' || (typeof logLevel === 'string' && Object.hasOwn(levels, logLevel))) {
+    return
+  }
+
+  throw new FST_ERR_LOG_INVALID_LOG_LEVEL(logLevel, Object.keys(levels).concat('silent').join(', '))
+}
