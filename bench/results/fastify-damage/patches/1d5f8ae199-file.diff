@@ -558,6 +558,21 @@ Configure the Ajv v8 instance used by Fastify without providing a custom one.
 The default configuration is explained in the
 [#schema-validator](./Validation-and-Serialization.md#schema-validator) section.
 
+This object is forwarded as-is to
+[`@fastify/ajv-compiler`](https://github.com/fastify/ajv-compiler#options), so
+every option that module supports is accepted here:
+
++ `customOptions`: the [Ajv options](https://ajv.js.org/options.html) used to
+  build the instance.
++ `plugins`: the Ajv plugins to apply. Each plugin must return the Ajv instance
+  it receives, as required by the
+  [Ajv plugin signature](https://ajv.js.org/packages/#ajv-plugins).
++ `onCreate`: a function called with the freshly created Ajv instance, useful to
+  tweak it further (for example to add keywords or formats).
++ `mode`: set it to `'JTD'` to compile
+  [JSON Type Definition](https://ajv.js.org/json-type-definition.html) schemas
+  instead of JSON Schema ones. `customOptions` then takes Ajv's JTD options.
+
 ```js
 const fastify = require('fastify')({
   ajv: {
@@ -569,7 +584,10 @@ const fastify = require('fastify')({
       [require('ajv-keywords'), 'instanceof']
       // Usage: [plugin, pluginOptions] - Plugin with options
       // Usage: plugin - Plugin without options
-    ]
+    ],
+    onCreate: (ajvInstance) => {
+      ajvInstance.addFormat('objectId', /^[0-9a-fA-F]{24}$/)
+    }
   }
 })
 ```
