+test('socket._meta is cleared on reply.hijack() when onTimeout is registered', async t => {
+  t.plan(3)
+  const fastify = Fastify({ connectionTimeout: 500 })
+  t.after(() => { fastify.close() })
+
+  fastify.addHook('onTimeout', function (req, res, done) { done() })
+
+  fastify.get('/', async (req, reply) => {
+    // yield once so the routing path has stored the metadata for this request
+    await Promise.resolve()
+    t.assert.ok(req.raw.socket._meta, 'socket._meta is set before hijacking')
+    reply.hijack()
+    t.assert.strictEqual(req.raw.socket._meta, null, 'socket._meta must be null after hijack')
+    reply.raw.writeHead(200, { 'content-type': 'text/plain' })
+    reply.raw.end('hijacked')
+  })
+
+  const address = await fastify.listen({ port: 0 })
+  const result = await fetch(address)
+  t.assert.strictEqual(await result.text(), 'hijacked')
+})
+
