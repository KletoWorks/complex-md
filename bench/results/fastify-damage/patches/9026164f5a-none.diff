+test('duplicate trailer completion is ignored when mixing callback and promise', (t, testDone) => {
+  t.plan(6)
+  const fastify = Fastify()
+
+  fastify.get('/', function (request, reply) {
+    // this handler completes twice: once via the callback and once by
+    // resolving the returned promise. only the first one should count.
+    reply.trailer('Return-Early', async function (reply, payload, done) {
+      done(null, 'callback')
+      return 'promise'
+    })
+    reply.trailer('Content-MD5', async function (reply, payload) {
+      await sleep(100)
+      return 'slow'
+    })
+    reply.send('hello')
+  })
+
+  fastify.inject({
+    method: 'GET',
+    url: '/'
+  }, (error, res) => {
+    t.assert.ifError(error)
+    t.assert.strictEqual(res.statusCode, 200)
+    t.assert.strictEqual(res.headers.trailer, 'return-early content-md5')
+    t.assert.strictEqual(res.trailers['return-early'], 'callback')
+    // the sibling trailer must not be dropped by the duplicate completion
+    t.assert.strictEqual(res.trailers['content-md5'], 'slow')
+    t.assert.ok(!res.headers['content-length'])
+    testDone()
+  })
+})
+
