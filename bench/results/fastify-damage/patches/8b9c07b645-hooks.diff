+test('socket _meta is released after the response, without leaking timeout listeners', async t => {
+  t.plan(5)
+  const fastify = Fastify({ connectionTimeout: 500 })
+  t.after(() => { fastify.close() })
+
+  fastify.addHook('onTimeout', function (req, res, done) {
+    done()
+  })
+
+  const sockets = []
+  fastify.get('/', async (req, reply) => {
+    sockets.push(req.raw.socket)
+    return reply.send({ hello: 'world' })
+  })
+
+  const fastifyServer = await fastify.listen({ port: 0 })
+  const agent = new http.Agent({ keepAlive: true, maxSockets: 1 })
+  t.after(() => { agent.destroy() })
+
+  const get = () => new Promise((resolve, reject) => {
+    http.get(fastifyServer, { agent }, res => {
+      res.resume()
+      res.on('end', resolve)
+    }).on('error', reject)
+  })
+
+  await get()
+  await get()
+
+  // both requests rode the same keep-alive socket
+  t.assert.strictEqual(sockets.length, 2)
+  t.assert.strictEqual(sockets[0], sockets[1])
+
+  const socket = sockets[0]
+  // the context/request/reply are no longer reachable from the live socket
+  t.assert.strictEqual(socket._meta, null)
+  // ...but the sentinel is preserved, so the listener was attached only once
+  t.assert.strictEqual(socket.listeners('timeout').filter(fn => fn.name === 'handleTimeout').length, 1)
+
+  // an idle 'timeout' with no request in flight must not throw
+  t.assert.doesNotThrow(() => socket.emit('timeout'))
+})
+
