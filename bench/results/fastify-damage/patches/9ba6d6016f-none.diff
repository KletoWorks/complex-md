+test('does not destroy in-flight requests (idle, native)', { skip: noSupport }, async t => {
+  t.plan(2)
+
+  const fastify = Fastify({ forceCloseConnections: 'idle' })
+
+  fastify.get('/', async () => {
+    await sleep(400)
+    return { hello: 'world' }
+  })
+
+  await fastify.listen({ port: 0 })
+
+  const client = new Client('http://localhost:' + fastify.server.address().port)
+  t.after(() => client.destroy())
+
+  const request = client.request({ path: '/', method: 'GET' })
+
+  await sleep(100)
+  const closed = fastify.close()
+
+  const response = await request
+  t.assert.strictEqual(response.statusCode, 200)
+  t.assert.deepStrictEqual(await response.body.json(), { hello: 'world' })
+
+  // the socket is only idle once the response has been read, so it must be
+  // released here for `close()` to settle without waiting on a server timeout
+  await client.close()
+  await closed
+})
+
