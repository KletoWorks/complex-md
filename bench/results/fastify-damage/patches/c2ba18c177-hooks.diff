+// Node.js calls closeIdleConnections() from within server.close(), so only the
+// calls happening before close() are the ones Fastify makes explicitly.
+function countExplicitCloseIdleConnections (server) {
+  const counter = { calls: 0 }
+  const closeIdleConnections = server.closeIdleConnections.bind(server)
+  const close = server.close.bind(server)
+  let closing = false
+
+  server.closeIdleConnections = function () {
+    if (!closing) counter.calls++
+    return closeIdleConnections()
+  }
+  server.close = function (...args) {
+    closing = true
+    return close(...args)
+  }
+
+  return counter
+}
+
+test('does not call closeIdleConnections on a native server (idle)', { skip: noSupport }, async t => {
+  t.plan(1)
+
+  const fastify = Fastify({ forceCloseConnections: 'idle' })
+  const counter = countExplicitCloseIdleConnections(fastify.server)
+
+  fastify.get('/', (req, reply) => {
+    reply.send({ hello: 'world' })
+  })
+
+  await fastify.listen({ port: 0 })
+  await fastify.close()
+
+  t.assert.strictEqual(counter.calls, 0)
+})
+
+test('calls closeIdleConnections on a serverFactory server (idle)', { skip: noSupport }, async t => {
+  t.plan(1)
+
+  let counter
+  const fastify = Fastify({
+    forceCloseConnections: 'idle',
+    serverFactory (handler, opts) {
+      const server = http.createServer(handler)
+      counter = countExplicitCloseIdleConnections(server)
+      return server
+    }
+  })
+
+  fastify.get('/', (req, reply) => {
+    reply.send({ hello: 'world' })
+  })
+
+  await fastify.listen({ port: 0 })
+  await fastify.close()
+
+  t.assert.strictEqual(counter.calls, 1)
+})
+
