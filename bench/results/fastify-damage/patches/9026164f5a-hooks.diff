+test('duplicate trailer completions are ignored when mixing callback and promise', (t, testDone) => {
+  t.plan(6)
+  const fastify = Fastify()
+  let endCalls = 0
+
+  fastify.get('/', function (request, reply) {
+    const originalEnd = reply.raw.end.bind(reply.raw)
+    reply.raw.end = function (...args) {
+      endCalls++
+      return originalEnd(...args)
+    }
+    // completes twice: once through the callback, once by resolving
+    reply.trailer('Return-Early', async function (reply, payload, done) {
+      done(null, 'first')
+      return 'second'
+    })
+    reply.trailer('Content-MD5', async function (reply, payload) {
+      await sleep(100)
+      return 'slow'
+    })
+    reply.send('hello')
+  })
+
+  fastify.inject({
+    method: 'GET',
+    url: '/'
+  }, (error, res) => {
+    t.assert.ifError(error)
+    t.assert.strictEqual(res.statusCode, 200)
+    t.assert.strictEqual(res.trailers['return-early'], 'first')
+    t.assert.strictEqual(res.trailers['content-md5'], 'slow')
+    t.assert.strictEqual(endCalls, 1)
+    t.assert.ok(!res.headers['content-length'])
+    testDone()
+  })
+})
+
