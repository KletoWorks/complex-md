@@ -614,7 +614,11 @@ function runPreParsing (err, request, reply) {
 }
 
 function buildRouterOptions (options, defaultOptions) {
-  const routerOptions = options.routerOptions || Object.create(null)
+  // A copy is made because the same server options object may be used to build
