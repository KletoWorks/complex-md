+test('Reply should add a charset when a quoted parameter value contains "charset="', async t => {
+  t.plan(2)
+
+  const fastify = require('../../')()
+
+  fastify.get('/quoted-charset', function (req, reply) {
+    reply
+      .type('application/json; name="a=b;charset=fake"')
+      .send({ hello: 'world' })
+  })
+
+  const res = await fastify.inject('/quoted-charset')
+  // The `charset=` substring lives inside a quoted parameter value, so it is
+  // not a `charset` parameter and must not suppress the default one.
+  t.assert.strictEqual(
+    res.headers['content-type'],
+    'application/json; name="a=b;charset=fake"; charset=utf-8'
+  )
+  t.assert.deepStrictEqual(res.json(), { hello: 'world' })
+})
+
