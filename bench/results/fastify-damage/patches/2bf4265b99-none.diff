+
+test('http2 large payload test', async t => {
+  const fastify = Fastify({ http2: true })
+  // bigger than a single chunk, so the write is split
+  const large = Buffer.alloc(5 * 1024 * 1024, 'a')
+
+  fastify.get('/large', function (req, reply) {
+    reply.type('application/octet-stream').send(large)
+  })
+
+  fastify.get('/large-string', function (req, reply) {
+    reply.type('text/plain').send(large.toString())
+  })
+
+  fastify.get('/', function (req, reply) {
+    reply.code(200).send(msg)
+  })
+
+  t.after(() => fastify.close())
+
+  await fastify.listen({ port: 0 })
+  const url = `http://localhost:${fastify.server.address().port}`
+
+  await t.test('a large buffer is sent in full', async (t) => {
+    t.plan(3)
+
+    const client = http2.connect(url)
+    t.after(() => client.close())
+
+    const req = client.request({ ':path': '/large' })
+    const [headers] = await once(req, 'response')
+    const body = Buffer.concat(await req.toArray())
+
+    t.assert.strictEqual(headers[':status'], 200)
+    t.assert.strictEqual(headers['content-length'], '' + large.length)
+    t.assert.ok(body.equals(large))
+  })
+
+  await t.test('a large string is sent in full', async (t) => {
+    t.plan(2)
+
+    const client = http2.connect(url)
+    t.after(() => client.close())
+
+    const req = client.request({ ':path': '/large-string' })
+    const [headers] = await once(req, 'response')
+    const body = Buffer.concat(await req.toArray())
+
+    t.assert.strictEqual(headers['content-length'], '' + large.length)
+    t.assert.ok(body.equals(large))
+  })
+
+  await t.test('cancelling a large payload does not poison the session', async (t) => {
+    t.plan(2)
+
+    const client = http2.connect(url)
+    t.after(() => client.close())
+
+    // request the large payload and cancel it without reading the body, so
+    // that the server is still writing when the stream goes away
+    const cancelled = client.request({ ':path': '/large' })
+    await once(cancelled, 'response')
+    cancelled.close(http2.constants.NGHTTP2_CANCEL)
+    await once(cancelled, 'close')
+
+    // the session must still be usable
+    const req = client.request({ ':path': '/' })
+    const [headers] = await once(req, 'response')
+    const body = Buffer.concat(await req.toArray()).toString()
+
+    t.assert.strictEqual(headers[':status'], 200)
+    t.assert.deepStrictEqual(JSON.parse(body), msg)
+  })
+})
