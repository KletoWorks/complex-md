+// Writing a big payload to an HTTP/2 stream with a single `write` hands the
+// whole buffer over to the session at once. If the client cancels the request
+// (RST_STREAM) while that data is still queued, the session is left with data
+// it can no longer flush and stops serving the other streams multiplexed on
+// it. Writing in bounded chunks keeps the queue small and lets us stop as soon
+// as the stream goes away.
+function sendChunkedPayload (payload, res, reply) {
+  // Strings cannot be split safely by character (a slice may cut a surrogate
+  // pair and change the byte length), so we always chunk over bytes.
+  const buffer = Buffer.isBuffer(payload) ? payload : Buffer.from(payload)
+  let offset = 0
+
+  function write () {
+    while (offset < buffer.length) {
+      // the client is gone, there is no point in feeding the session
+      if (res.destroyed || res.writableEnded) return
+
+      const chunk = buffer.subarray(offset, offset + HTTP2_CHUNK_SIZE)
+      offset += chunk.length
+
+      if (res.write(chunk) === false && offset < buffer.length) {
+        res.once('drain', write)
+        return
+      }
+    }
+
+    // then send trailers
+    sendTrailer(payload, res, reply)
+  }
+
+  write()
+}
