diff --git a/test/close.test.js b/test/close.test.js
index 810ffe4f..8f048f99 100644
--- a/test/close.test.js
+++ b/test/close.test.js
@@ -704,3 +704,56 @@ test('preClose execution order', (t, done) => {
     })
   })
 })
+
+// Counts the closeIdleConnections() calls Fastify performs on its own, that is
+// the ones happening before server.close(), which invokes it internally too.
+function countExplicitCloseIdleConnections (server) {
+  const counter = { calls: 0 }
+  const closeIdleConnections = server.closeIdleConnections
+  const close = server.close
+
+  server.closeIdleConnections = function () {
+    counter.calls++
+    return closeIdleConnections.call(this)
+  }
+  server.close = function (...args) {
+    server.closeIdleConnections = closeIdleConnections
+    return close.apply(this, args)
+  }
+
+  return counter
+}
+
+test('does not call closeIdleConnections on a native server', async t => {
+  t.plan(1)
+
+  const fastify = Fastify({ forceCloseConnections: 'idle' })
+
+  await fastify.listen({ port: 0 })
+
+  const counter = countExplicitCloseIdleConnections(fastify.server)
+
+  await fastify.close()
+
+  // the native server closes the idle connections as part of server.close()
+  t.assert.strictEqual(counter.calls, 0)
+})
+
+test('calls closeIdleConnections on a server built by serverFactory', async t => {
+  t.plan(1)
+
+  let counter
+  const fastify = Fastify({
+    forceCloseConnections: 'idle',
+    serverFactory: (handler) => {
+      const server = http.createServer(handler)
+      counter = countExplicitCloseIdleConnections(server)
+      return server
+    }
+  })
+
+  await fastify.listen({ port: 0 })
+  await fastify.close()
+
+  t.assert.strictEqual(counter.calls, 1)
+})
