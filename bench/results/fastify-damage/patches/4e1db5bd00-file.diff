+
+test('trust proxy, untrusted peer cannot spoof host and protocol', async t => {
+  t.plan(4)
+  const app = fastify({
+    // the loopback address the request comes from is deliberately not trusted
+    trustProxy: '2.2.2.2'
+  })
+  t.after(() => app.close())
+
+  app.get('/untrustedproxy', function (req, reply) {
+    const { port } = app.server.address()
+    t.assert.strictEqual(req.host, `${localhostForURL}:${port}`, 'x-forwarded-host is ignored')
+    t.assert.strictEqual(req.hostname, localhostForURL, 'hostname is derived from the host header')
+    t.assert.strictEqual(req.port, port, 'port is derived from the host header')
+    t.assert.strictEqual(req.protocol, 'http', 'x-forwarded-proto is ignored')
+    reply.code(200).send({ host: req.host, protocol: req.protocol })
+  })
+
+  const fastifyServer = await app.listen({ port: 0 })
+  await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/untrustedproxy', 'https')
+})
