+
+test('trust proxy number without a socket address', { skip: os.platform() === 'win32' }, async t => {
+  t.plan(4)
+
+  // A unix socket, like a Windows named pipe (iisnode), has no remote address,
+  // but the hop count is still trusted
+  const app = fastify({
+    trustProxy: 1
+  })
+  const socketPath = path.join(os.tmpdir(), `fastify-trust-proxy-${process.pid}.sock`)
+  t.after(async () => {
+    await app.close()
+    await fs.rm(socketPath, { force: true })
+  })
+
+  app.get('/trustproxynumber', function (req, reply) {
+    t.assert.strictEqual(req.ip, '1.1.1.1', 'gets ip from x-forwarded-for')
+    t.assert.strictEqual(req.host, 'fastify.test', 'gets host from x-forwarded-host')
+    t.assert.strictEqual(req.hostname, 'fastify.test', 'gets hostname from x-forwarded-host')
+    t.assert.strictEqual(req.protocol, 'https', 'gets protocol from x-forwarded-proto')
+    reply.code(200).send({ ip: req.ip, host: req.host })
+  })
+
+  await app.listen({ path: socketPath })
+
+  await new Promise((resolve, reject) => {
+    const request = http.request({
+      socketPath,
+      path: '/trustproxynumber',
+      headers: {
+        host: 'localhost',
+        'X-Forwarded-For': '1.1.1.1',
+        'X-Forwarded-Host': 'fastify.test',
+        'X-Forwarded-Proto': 'https'
+      }
+    }, res => {
+      res.resume()
+      res.on('end', resolve)
+    })
+    request.on('error', reject)
+    request.end()
+  })
+})
