diff --git a/docs/Reference/Reply.md b/docs/Reference/Reply.md
index 5c60a134..693b3b62 100644
--- a/docs/Reference/Reply.md
+++ b/docs/Reference/Reply.md
@@ -705,6 +705,14 @@ If you are sending a stream and you have not set a `'Content-Type'` header,
 As noted above, streams are considered to be pre-serialized, so they will be
 sent unmodified without response validation.
 
+Because streams are piped unmodified, Fastify does not split the chunks they
+emit. Over HTTP/2 a single very large chunk is queued as one write on the
+session, and if the client cancels the stream while that write is pending, the
+whole session can be left unable to serve further requests. Streams that emit
+large chunks should therefore split them into smaller ones, for example by
+passing a `highWaterMark` to `fs.createReadStream`. Buffers and strings passed
+to *send* are chunked by Fastify and need no special handling.
+
 See special note about error handling for streams in
 [`setErrorHandler`](./Server.md#seterrorhandler).
 
diff --git a/lib/reply.js b/lib/reply.js
index 38d2ca97..95fbfe11 100644
--- a/lib/reply.js
+++ b/lib/reply.js
@@ -61,6 +61,12 @@ const decorators = require('./decorate')
 
 const toString = Object.prototype.toString
 
+// Node's HTTP/2 stack queues a `write()` as a single unit on the session. If the
+// stream is cancelled while a very large write is still queued, the session is
+// left unable to serve any further stream, so we split large payloads into
+// bounded chunks. HTTP/1 is unaffected and keeps its single write.
+const HTTP2_CHUNK_SIZE = 64 * 1024
+
 function Reply (res, request, log) {
   this.raw = res
   this[kReplySerializer] = null
@@ -677,11 +683,32 @@ function onSendEnd (reply, payload) {
 
   safeWriteHead(reply, statusCode)
   // write payload first
-  res.write(payload)
+  writePayload(res, payload)
   // then send trailers
   sendTrailer(payload, res, reply)
 }
 
+// Writes a string or Buffer payload to the response. On HTTP/2 a payload larger
+// than HTTP2_CHUNK_SIZE is written in chunks, see the constant's comment. Only
+// payloads Fastify writes itself are chunked; user-provided streams are piped
+// untouched, so an application emitting very large chunks has to split them.
+function writePayload (res, payload) {
+  // `stream` is only present on an Http2ServerResponse
+  const stream = res.stream
+  if (stream === undefined || Buffer.byteLength(payload) <= HTTP2_CHUNK_SIZE) {
+    res.write(payload)
+    return
+  }
+
+  // slicing a string could split a multi-byte character across two writes
+  const buffer = Buffer.isBuffer(payload) ? payload : Buffer.from(payload)
+  for (let offset = 0; offset < buffer.length; offset += HTTP2_CHUNK_SIZE) {
+    // the peer can cancel the stream while we are still queueing chunks
+    if (stream.destroyed) break
+    res.write(buffer.subarray(offset, offset + HTTP2_CHUNK_SIZE))
+  }
+}
