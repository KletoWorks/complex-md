diff --git a/test/http2/plain.test.js b/test/http2/plain.test.js
index 3e1d5b4c..60ffcd11 100644
--- a/test/http2/plain.test.js
+++ b/test/http2/plain.test.js
@@ -1,6 +1,7 @@
 'use strict'
 
 const { test } = require('node:test')
+const http2 = require('node:http2')
 const Fastify = require('../..')
 const h2url = require('h2url')
 const msg = { hello: 'world' }
@@ -66,3 +67,82 @@ test('http2 plain test', async t => {
     t.assert.strictEqual(JSON.parse(res.body).port, parseInt(host.split(':')[1]))
   })
 })
+
+test('http2 large payload test', async t => {
+  // large enough that writing it in a single write poisons the session when the
+  // stream is cancelled, see HTTP2_CHUNK_SIZE in lib/reply.js
+  const big = Buffer.alloc(16 * 1024 * 1024, 0x61)
+  const multiByte = '🌏'.repeat(1024 * 1024)
+
+  const fastify = Fastify({ http2: true })
+
+  fastify.get('/big', function (req, reply) {
+    reply.header('content-type', 'application/octet-stream').send(big)
+  })
+
+  fastify.get('/multi-byte', function (req, reply) {
+    reply.type('text/plain; charset=utf-8').send(multiByte)
+  })
+
+  fastify.get('/small', function (req, reply) {
+    reply.send(msg)
+  })
+
+  t.after(() => { fastify.close() })
+
+  await fastify.listen({ port: 0 })
+  const url = `http://localhost:${fastify.server.address().port}`
+
+  await t.test('sends a large buffer in one piece', async (t) => {
+    t.plan(3)
+
+    const res = await h2url.concat({ url: `${url}/big` })
+
+    t.assert.strictEqual(res.headers[':status'], 200)
+    t.assert.strictEqual(res.headers['content-length'], '' + big.length)
+    t.assert.ok(Buffer.from(res.body, 'binary').equals(big), 'payload is intact')
+  })
+
+  await t.test('does not split multi-byte characters', async (t) => {
+    t.plan(2)
+
+    const res = await h2url.concat({ url: `${url}/multi-byte` })
+
+    t.assert.strictEqual(res.headers['content-length'], '' + Buffer.byteLength(multiByte))
+    t.assert.strictEqual(res.body, multiByte)
+  })
+
+  await t.test('cancelling a large payload keeps the session usable', async (t) => {
+    t.plan(2)
+
+    const session = http2.connect(url)
+    t.after(() => { session.close() })
+
+    // cancel the large reply as soon as the response headers arrive, while the
+    // payload is still being written
+    await new Promise((resolve, reject) => {
+      const req = session.request({ ':path': '/big' })
+      req.on('response', () => {
+        req.close(http2.constants.NGHTTP2_CANCEL)
+        resolve()
+      })
+      req.on('error', reject)
+      req.resume()
+      req.end()
+    })
+
+    // reusing the same session must still work
+    const body = await new Promise((resolve, reject) => {
+      const req = session.request({ ':path': '/small' })
+      let body = ''
+      req.setEncoding('utf8')
+      req.on('data', (chunk) => { body += chunk })
+      req.on('end', () => resolve(body))
+      req.on('error', reject)
+      req.end()
+    })
+
+    t.assert.deepStrictEqual(JSON.parse(body), msg)
+    t.assert.strictEqual(session.destroyed, false)
+  })
+})
