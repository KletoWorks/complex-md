diff --git a/test/http-methods/custom-http-methods.test.js b/test/http-methods/custom-http-methods.test.js
index 61feed4e..5d30e7ce 100644
--- a/test/http-methods/custom-http-methods.test.js
+++ b/test/http-methods/custom-http-methods.test.js
@@ -112,3 +112,65 @@ test('addHttpMethod rejects fake http method', t => {
   const fastify = Fastify()
   t.assert.throws(() => { fastify.addHttpMethod('FOOO') }, /Provided method is invalid!/)
 })
+
+test('addHttpMethod does not override a standard http method', t => {
+  t.plan(3)
+  const app = Fastify()
+
+  t.assert.throws(() => { app.addHttpMethod('GET', { hasBody: true }) }, {
+    code: 'FST_ERR_ROUTE_METHOD_ALREADY_SUPPORTED',
+    message: 'GET method is already supported. Set the "override" option to true to change its body support.'
+  })
+  t.assert.throws(() => { app.addHttpMethod('POST') }, {
+    code: 'FST_ERR_ROUTE_METHOD_ALREADY_SUPPORTED'
+  })
+
+  t.assert.deepStrictEqual(app.supportedMethods, [
+    'GET', 'HEAD', 'TRACE', 'DELETE', 'OPTIONS', 'PATCH', 'PUT', 'POST', 'QUERY'
+  ])
+})
+
+test('addHttpMethod does not override a custom http method', t => {
+  t.plan(2)
+  const app = Fastify()
+
+  app.addHttpMethod('REBIND', { hasBody: true })
+  t.assert.throws(() => { app.addHttpMethod('REBIND') }, {
+    code: 'FST_ERR_ROUTE_METHOD_ALREADY_SUPPORTED'
+  })
+
+  t.assert.doesNotThrow(() => {
+    app.route({
+      url: '/',
+      method: 'REBIND',
+      schema: { body: { type: 'object' } },
+      handler: function (req, reply) { reply.send(req.body) }
+    })
+  })
+})
+
+test('addHttpMethod re-adding a method with the same body support is a no-op', t => {
+  t.plan(2)
+  const app = Fastify()
+
+  t.assert.doesNotThrow(() => { app.addHttpMethod('GET') })
+  t.assert.doesNotThrow(() => { app.addHttpMethod('POST', { hasBody: true }) })
+})
+
+test('addHttpMethod overrides an existing method when override is set', (t, done) => {
+  t.plan(3)
+  const app = Fastify()
+
+  app.addHttpMethod('TRACE', { hasBody: true, override: true })
+  t.assert.doesNotThrow(() => { addEcho(app, 'TRACE') })
+
+  app.inject({
+    method: 'TRACE',
+    url: '/',
+    payload: { hello: 'world' }
+  }, (err, response) => {
+    t.assert.ifError(err)
+    t.assert.deepStrictEqual(response.json(), { hello: 'world' })
+    done()
+  })
+})
