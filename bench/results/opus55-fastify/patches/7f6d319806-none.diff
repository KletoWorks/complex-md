+test('socket._meta is cleared on reply.hijack() when onTimeout is registered', async t => {
+  t.plan(4)
+  const fastify = Fastify({ connectionTimeout: 500 })
+  t.after(() => { fastify.close() })
+
+  fastify.addHook('onTimeout', function (req, res, done) { done() })
+
+  fastify.get('/', (req, reply) => {
+    t.assert.ok(req.raw.socket._meta, 'socket._meta must be set before hijack')
+    reply.hijack()
+    t.assert.strictEqual(req.raw.socket._meta, null, 'socket._meta must be null after hijack')
+    reply.raw.end('hello world')
+  })
+
+  const address = await fastify.listen({ port: 0 })
+  const result = await fetch(address)
+  t.assert.ok(result.ok)
+  t.assert.strictEqual(await result.text(), 'hello world')
+})
+
+test('socket timeout after a finished response does not throw when onTimeout is registered', (t, done) => {
+  t.plan(2)
+  const fastify = Fastify({ connectionTimeout: 200 })
+  t.after(() => { fastify.close() })
+
+  fastify.addHook('onTimeout', function (req, res, done) {
+    t.assert.fail('onTimeout must not be called after the response finished')
+    done()
+  })
+
+  fastify.get('/', async () => ({ hello: 'world' }))
+
+  fastify.listen({ port: 0 }, (err, address) => {
+    t.assert.ifError(err)
+    const { port } = new URL(address)
+    const client = connect(port, '127.0.0.1', () => {
+      client.write('GET / HTTP/1.1\r\nHost: localhost\r\nConnection: keep-alive\r\n\r\n')
+    })
+    client.resume()
+    // Server closes the idle keep-alive socket on connectionTimeout
+    client.on('close', () => {
+      t.assert.ok('socket closed without error')
+      done()
+    })
+  })
+})
+
