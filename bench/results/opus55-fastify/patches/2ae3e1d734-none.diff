diff --git a/test/route-log-level.test.js b/test/route-log-level.test.js
new file mode 100644
index 00000000..bc18ace3
--- /dev/null
+++ b/test/route-log-level.test.js
@@ -0,0 +1,44 @@
+'use strict'
+
+const { test } = require('node:test')
+const Fastify = require('..')
+
+test('should throw on route registration with an invalid logLevel', t => {
+  t.plan(2)
+  const fastify = Fastify({ logger: { level: 'silent' } })
+
+  try {
+    fastify.get('/', { logLevel: 'invalid' }, async () => 'hello world')
+    t.assert.fail('should throw')
+  } catch (err) {
+    t.assert.strictEqual(err.code, 'FST_ERR_ROUTE_LOG_LEVEL_INVALID')
+    t.assert.strictEqual(err.message, "'logLevel' option must be a valid log level. Got 'invalid'")
+  }
+})
+
+test('should throw on route registration with an invalid plugin logLevel', async t => {
+  t.plan(1)
+  const fastify = Fastify({ logger: { level: 'silent' } })
+
+  fastify.register(async (instance) => {
+    instance.get('/', async () => 'hello world')
+  }, { logLevel: 'invalid' })
+
+  await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_ROUTE_LOG_LEVEL_INVALID' })
+})
+
+test('should accept valid, silent and custom logLevel values', async t => {
+  t.plan(3)
+  const fastify = Fastify({
+    logger: { level: 'silent', customLevels: { audit: 35 } }
+  })
+
+  fastify.get('/info', { logLevel: 'info' }, async () => 'info')
+  fastify.get('/silent', { logLevel: 'silent' }, async () => 'silent')
+  fastify.get('/audit', { logLevel: 'audit' }, async () => 'audit')
+
+  for (const url of ['/info', '/silent', '/audit']) {
+    const res = await fastify.inject(url)
+    t.assert.strictEqual(res.statusCode, 200)
+  }
+})
