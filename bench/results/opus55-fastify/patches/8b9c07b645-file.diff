+test('socket _meta is cleared after response on keep-alive sockets', async t => {
+  t.plan(4)
+  const fastify = Fastify({ connectionTimeout: 5000 })
+  t.after(() => fastify.close())
+
+  fastify.addHook('onTimeout', function (req, res, done) {
+    done()
+  })
+
+  const seen = []
+  let resolve
+  const responded = new Promise(r => { resolve = r })
+  fastify.addHook('onResponse', function (req, reply, done) {
+    const socket = req.raw.socket
+    seen.push({ socket, meta: socket._meta, listeners: socket.listenerCount('timeout') })
+    if (seen.length === 2) resolve()
+    done()
+  })
+
+  fastify.get('/', async () => ({ hello: 'world' }))
+
+  const fastifyServer = await fastify.listen({ port: 0 })
+
+  const http = require('node:http')
+  const agent = new http.Agent({ keepAlive: true, maxSockets: 1 })
+  t.after(() => agent.destroy())
+  const get = () => new Promise((resolve, reject) => {
+    http.get(fastifyServer, { agent }, res => {
+      res.resume()
+      res.on('end', resolve)
+    }).on('error', reject)
+  })
+
+  await Promise.all([get(), get()])
+  await responded
+
+  t.assert.strictEqual(seen[0].socket, seen[1].socket, 'socket is reused')
+  t.assert.strictEqual(seen[0].meta, null)
+  t.assert.strictEqual(seen[1].meta, null)
+  t.assert.strictEqual(seen[1].listeners, seen[0].listeners, 'timeout listener is not re-added')
+})
+
