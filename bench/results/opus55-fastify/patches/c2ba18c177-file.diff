+function spyCloseIdleConnectionsBeforeClose (server) {
+  const spy = { calls: 0 }
+  let closing = false
+
+  const originalCloseIdleConnections = server.closeIdleConnections
+  server.closeIdleConnections = function () {
+    if (!closing) spy.calls++
+    return originalCloseIdleConnections.apply(this, arguments)
+  }
+
+  const originalClose = server.close
+  server.close = function () {
+    closing = true
+    return originalClose.apply(this, arguments)
+  }
+
+  return spy
+}
+
+test('does not call closeIdleConnections before server.close on native servers (forceCloseConnections - idle)', { skip: noSupport }, async t => {
+  t.plan(1)
+
+  const fastify = Fastify({ forceCloseConnections: 'idle' })
+  const spy = spyCloseIdleConnectionsBeforeClose(fastify.server)
+
+  await fastify.listen({ port: 0 })
+  await fastify.close()
+
+  t.assert.strictEqual(spy.calls, 0)
+})
+
+test('calls closeIdleConnections before server.close on serverFactory servers (forceCloseConnections - idle)', { skip: noSupport }, async t => {
+  t.plan(1)
+
+  let spy
+  const fastify = Fastify({
+    forceCloseConnections: 'idle',
+    serverFactory (handler) {
+      const server = http.createServer(handler)
+      spy = spyCloseIdleConnectionsBeforeClose(server)
+      return server
+    }
+  })
+
+  await fastify.listen({ port: 0 })
+  await fastify.close()
+
+  t.assert.strictEqual(spy.calls, 1)
+})
+
