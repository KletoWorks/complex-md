+// A single large write on an HTTP/2 stream that gets cancelled can leave
+// the whole session unusable, so large payloads are written in chunks
+// honoring backpressure and stop as soon as the stream is gone.
+function sendHttp2Chunked (payload, res, reply) {
+  const buffer = Buffer.isBuffer(payload) ? payload : Buffer.from(payload)
+  let offset = 0
+
+  function onClose () {
+    res.removeListener('drain', writeChunks)
+  }
+  res.once('close', onClose)
+
+  function writeChunks () {
+    while (offset < buffer.length) {
+      if (res.destroyed || res.writableEnded) {
+        res.removeListener('close', onClose)
+        return
+      }
+      const end = Math.min(offset + HTTP2_CHUNK_SIZE, buffer.length)
+      const chunk = buffer.subarray(offset, end)
+      offset = end
+      if (res.write(chunk) === false && offset < buffer.length) {
+        res.once('drain', writeChunks)
+        return
+      }
+    }
+    res.removeListener('close', onClose)
+    sendTrailer(payload, res, reply)
+  }
+
+  writeChunks()
+}
