+test('addHttpMethod does not override standard http methods', t => {
+  t.plan(4)
+  const app = Fastify()
+
+  app.addHttpMethod('GET', { hasBody: true })
+  app.addHttpMethod('POST')
+
+  t.assert.strictEqual(app.supportedMethods.filter(m => m === 'GET').length, 1)
+  t.assert.strictEqual(app.supportedMethods.filter(m => m === 'POST').length, 1)
+
+  t.assert.throws(() => {
+    app.get('/', { schema: { body: { type: 'object' } } }, () => {})
+  }, /Body validation schema for GET:\/ route is not supported!/)
+  t.assert.doesNotThrow(() => {
+    app.post('/', { schema: { body: { type: 'object' } } }, () => {})
+  })
+})
+
+test('addHttpMethod does not override previously added http methods', t => {
+  t.plan(1)
+  const app = Fastify()
+
+  app.addHttpMethod('REBIND', { hasBody: true })
+  app.addHttpMethod('REBIND')
+
+  t.assert.doesNotThrow(() => {
+    app.rebind('/', { schema: { body: { type: 'object' } } }, () => {})
+  })
+})
