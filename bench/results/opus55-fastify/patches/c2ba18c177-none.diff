+test('should not call closeIdleConnections an extra time on native servers (forceCloseConnections - idle)', { skip: noSupport }, async t => {
+  const fastify = Fastify({ forceCloseConnections: 'idle' })
+
+  await fastify.listen({ port: 0 })
+
+  let calls = 0
+  const closeIdleConnections = fastify.server.closeIdleConnections
+  fastify.server.closeIdleConnections = function () {
+    calls++
+    return closeIdleConnections.call(this)
+  }
+
+  await fastify.close()
+
+  // Only the call made by Node.js itself within server.close()
+  t.assert.strictEqual(calls, 1)
+})
+
+test('should call closeIdleConnections on custom servers (forceCloseConnections - idle)', { skip: noSupport }, async t => {
+  let calls = 0
+  const fastify = Fastify({
+    forceCloseConnections: 'idle',
+    serverFactory: (handler) => {
+      const server = http.createServer(handler)
+      const closeIdleConnections = server.closeIdleConnections
+      server.closeIdleConnections = function () {
+        calls++
+        return closeIdleConnections.call(this)
+      }
+      return server
+    }
+  })
+
+  await fastify.listen({ port: 0 })
+  await fastify.close()
+
+  // One call from Fastify and one from Node.js within server.close()
+  t.assert.strictEqual(calls, 2)
+})
+
