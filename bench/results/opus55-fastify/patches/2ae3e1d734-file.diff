+    t.plan(1)
+    const fastify = Fastify({ logger: { level: 'info' } })
+    t.after(() => fastify.close())
+    fastify.register(async (instance) => {
+      instance.get('/', async () => 'hello')
+    }, { logLevel: 'invalid' })
+    await t.assert.rejects(fastify.ready(), { code: 'FST_ERR_ROUTE_LOG_LEVEL_INVALID' })
