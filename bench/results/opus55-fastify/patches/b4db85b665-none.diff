diff --git a/test/router-options.test.js b/test/router-options.test.js
index cdb9d389..8b07e7fb 100644
--- a/test/router-options.test.js
+++ b/test/router-options.test.js
@@ -1064,3 +1064,29 @@ test('Should support extra find-my-way options', async t => {
   // Ensure the option is preserved after validation
   t.assert.strictEqual(typeof fastify.initialConfig.routerOptions.buildPrettyMeta, 'function')
 })
+
+test('Should allow reusing the same routerOptions object across multiple instances', async t => {
+  t.plan(6)
+
+  const options = { routerOptions: { maxParamLength: 2048 } }
+
+  const app1 = Fastify(options)
+  app1.get('/', async () => 'one')
+
+  const app2 = Fastify(options)
+  app2.get('/', async () => 'two')
+
+  t.assert.deepStrictEqual(options, { routerOptions: { maxParamLength: 2048 } })
+
+  const res1 = await app2.inject('/')
+  t.assert.strictEqual(res1.body, 'two')
+
+  const res2 = await app2.inject('/missing')
+  t.assert.strictEqual(res2.statusCode, 404)
+
+  const res3 = await app1.inject('/')
+  t.assert.strictEqual(res3.body, 'one')
+
+  t.assert.strictEqual(app1.initialConfig.routerOptions.maxParamLength, 2048)
+  t.assert.strictEqual(app2.initialConfig.routerOptions.maxParamLength, 2048)
+})
