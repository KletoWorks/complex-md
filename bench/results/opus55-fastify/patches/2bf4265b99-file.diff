 'use strict'
 
 const { test } = require('node:test')
+const http2 = require('node:http2')
 const Fastify = require('../..')
 const h2url = require('h2url')
 const msg = { hello: 'world' }
@@ -66,3 +67,80 @@ test('http2 plain test', async t => {
     t.assert.strictEqual(JSON.parse(res.body).port, parseInt(host.split(':')[1]))
   })
 })
+
+test('http2 large buffer reply is sent in chunks', async t => {
+  t.plan(5)
+
+  const payload = Buffer.alloc(1024 * 1024 + 7, 'a')
+  const fastify = Fastify({ http2: true })
+  const writes = []
+
+  fastify.addHook('onRequest', async function (req, reply) {
+    const write = reply.raw.write
+    reply.raw.write = function (chunk, ...args) {
+      writes.push(Buffer.byteLength(chunk))
+      return write.call(this, chunk, ...args)
+    }
+  })
+
+  fastify.get('/large', function (req, reply) {
+    reply.type('application/octet-stream').send(payload)
+  })
+
+  t.after(() => { fastify.close() })
+  await fastify.listen({ port: 0 })
+
+  const url = `http://localhost:${fastify.server.address().port}/large`
+  const res = await h2url.concat({ url })
+
+  t.assert.strictEqual(res.headers[':status'], 200)
+  t.assert.strictEqual(res.headers['content-length'], '' + payload.length)
+  t.assert.strictEqual(res.body.length, payload.length)
+  t.assert.ok(writes.length > 1)
+  t.assert.ok(writes.every((size) => size <= 64 * 1024))
+})
+
+test('http2 cancelled large reply does not break the session', async t => {
+  t.plan(2)
+
+  const payload = Buffer.alloc(8 * 1024 * 1024, 'a')
+  const fastify = Fastify({ http2: true })
+
+  fastify.get('/large', function (req, reply) {
+    reply.type('application/octet-stream').send(payload)
+  })
+  fastify.get('/', function (req, reply) {
+    reply.send(msg)
+  })
+
+  t.after(() => { fastify.close() })
+  await fastify.listen({ port: 0 })
+
+  const session = http2.connect(`http://localhost:${fastify.server.address().port}`)
+  t.after(() => { session.destroy() })
+
+  await new Promise((resolve, reject) => {
+    const req = session.request({ ':path': '/large' })
+    req.once('data', () => {
+      req.close(http2.constants.NGHTTP2_CANCEL)
+    })
+    req.on('close', resolve)
+    req.on('error', reject)
+    req.end()
+  })
+
+  const body = await new Promise((resolve, reject) => {
+    const req = session.request({ ':path': '/' })
+    let data = ''
+    req.setEncoding('utf8')
+    req.on('response', (headers) => {
+      t.assert.strictEqual(headers[':status'], 200)
+    })
+    req.on('data', (chunk) => { data += chunk })
+    req.on('end', () => resolve(data))
+    req.on('error', reject)
+    req.end()
+  })
+
+  t.assert.deepStrictEqual(JSON.parse(body), msg)
+})
