diff --git a/test/trust-proxy.test.js b/test/trust-proxy.test.js
index ae7b7568..0c8a6cac 100644
--- a/test/trust-proxy.test.js
+++ b/test/trust-proxy.test.js
@@ -160,3 +160,22 @@ test('trust proxy protocol', async t => {
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxynoprotocol', undefined)
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxyprotocols', 'ipsum, dolor')
 })
+
+test('trust proxy ignores x-forwarded-host and x-forwarded-proto from untrusted peer', async t => {
+  t.plan(3)
+  const app = fastify({
+    trustProxy: '192.168.1.1'
+  })
+  t.after(() => app.close())
+
+  app.get('/untrusted', function (req, reply) {
+    t.assert.strictEqual(req.ip, localhost, 'ip is the direct peer')
+    t.assert.notStrictEqual(req.host, 'fastify.test', 'host is not taken from x-forwarded-host')
+    t.assert.strictEqual(req.protocol, 'http', 'protocol is not taken from x-forwarded-proto')
+    reply.code(200).send()
+  })
+
+  const fastifyServer = await app.listen({ port: 0 })
+
+  await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/untrusted', 'https')
+})
