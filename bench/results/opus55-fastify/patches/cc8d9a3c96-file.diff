diff --git a/test/decorator.test.js b/test/decorator.test.js
index 972658f9..94985cfb 100644
--- a/test/decorator.test.js
+++ b/test/decorator.test.js
@@ -1328,3 +1328,61 @@ test('Request.setDecorator should update an existing decorator', (t, done) => {
     })
   })
 })
+
+describe('constructor-assigned built-in properties', () => {
+  const requestProps = ['id', 'params', 'raw', 'query', 'log', 'body']
+  const replyProps = ['raw', 'request', 'log']
+
+  test('hasRequestDecorator returns true for built-in request properties', t => {
+    const fastify = Fastify()
+    for (const name of requestProps) {
+      t.assert.strictEqual(fastify.hasRequestDecorator(name), true, name)
+    }
+  })
+
+  test('hasReplyDecorator returns true for built-in reply properties', t => {
+    const fastify = Fastify()
+    for (const name of replyProps) {
+      t.assert.strictEqual(fastify.hasReplyDecorator(name), true, name)
+    }
+  })
+
+  test('decorateRequest throws for built-in request properties', t => {
+    const fastify = Fastify()
+    for (const name of requestProps) {
+      t.assert.throws(() => fastify.decorateRequest(name, null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' }, name)
+    }
+  })
+
+  test('decorateReply throws for built-in reply properties', t => {
+    const fastify = Fastify()
+    for (const name of replyProps) {
+      t.assert.throws(() => fastify.decorateReply(name, null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' }, name)
+    }
+  })
+
+  test('built-in properties are detected inside encapsulated plugins', async t => {
+    const fastify = Fastify()
+    await fastify.register(async (instance) => {
+      t.assert.strictEqual(instance.hasRequestDecorator('id'), true)
+      t.assert.strictEqual(instance.hasReplyDecorator('raw'), true)
+      t.assert.throws(() => instance.decorateRequest('id', null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' })
+      t.assert.throws(() => instance.decorateReply('raw', null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' })
+    })
+  })
+
+  test('unrelated request and reply decorators still work', async t => {
+    const fastify = Fastify()
+    t.assert.strictEqual(fastify.hasRequestDecorator('myExtra'), false)
+    fastify.decorateRequest('myExtra', null)
+    fastify.decorateReply('myExtra', null)
+    t.assert.strictEqual(fastify.hasRequestDecorator('myExtra'), true)
+    t.assert.strictEqual(fastify.hasReplyDecorator('myExtra'), true)
+
+    fastify.get('/', (req, reply) => {
+      reply.send({ id: typeof req.id, extra: req.myExtra })
+    })
+    const res = await fastify.inject('/')
+    t.assert.deepStrictEqual(res.json(), { id: 'string', extra: null })
+  })
+})
