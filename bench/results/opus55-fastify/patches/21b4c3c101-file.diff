diff --git a/test/internals/request.test.js b/test/internals/request.test.js
index 7ca08eb6..97d8cd95 100644
--- a/test/internals/request.test.js
+++ b/test/internals/request.test.js
@@ -504,3 +504,27 @@ test('Request with trust proxy and undefined socket', t => {
   const request = new TpRequest('id', 'params', req, 'query', 'log')
   t.assert.deepStrictEqual(request.protocol, undefined)
 })
+
+test('Request with trust proxy treats null and undefined socket remoteAddress the same', t => {
+  const headers = {
+    host: 'hostname',
+    'x-forwarded-host': 'fastify.test',
+    'x-forwarded-proto': 'https'
+  }
+  const sockets = [null, undefined, { remoteAddress: null }, { remoteAddress: undefined }]
+  t.plan(sockets.length * 4)
+
+  for (const socket of sockets) {
+    const req = { method: 'GET', url: '/', socket, headers }
+
+    const TrustAllRequest = Request.buildRequest(Request, true)
+    const trustAll = new TrustAllRequest('id', 'params', req, 'query', 'log')
+    t.assert.strictEqual(trustAll.host, 'fastify.test')
+    t.assert.strictEqual(trustAll.protocol, 'https')
+
+    const TrustListRequest = Request.buildRequest(Request, '127.0.0.1')
+    const trustList = new TrustListRequest('id', 'params', req, 'query', 'log')
+    t.assert.strictEqual(trustList.host, 'hostname')
+    t.assert.notStrictEqual(trustList.protocol, 'https')
+  }
+})
