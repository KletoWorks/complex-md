diff --git a/test/trust-proxy.test.js b/test/trust-proxy.test.js
index ae7b7568..5211a446 100644
--- a/test/trust-proxy.test.js
+++ b/test/trust-proxy.test.js
@@ -160,3 +160,22 @@ test('trust proxy protocol', async t => {
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxynoprotocol', undefined)
   await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/trustproxyprotocols', 'ipsum, dolor')
 })
+
+test('trust proxy ignores x-forwarded-host and x-forwarded-proto from untrusted peers', async t => {
+  t.plan(4)
+  const app = fastify({
+    trustProxy: '10.0.0.1'
+  })
+  t.after(() => app.close())
+
+  app.get('/untrusted', function (req, reply) {
+    t.assert.notStrictEqual(req.host, 'fastify.test')
+    t.assert.strictEqual(req.host, req.headers.host)
+    t.assert.strictEqual(req.protocol, 'http')
+    t.assert.strictEqual(req.ip, localhost)
+    reply.code(200).send()
+  })
+
+  const fastifyServer = await app.listen({ port: 0, host: localhost })
+  await fetchForwardedRequest(fastifyServer, '1.1.1.1', '/untrusted', 'https')
+})
