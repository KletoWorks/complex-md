+
+test('trust proxy hop count works over a pipe/unix socket without remoteAddress', { skip: process.platform === 'win32' }, async t => {
+  t.plan(3)
+
+  // iisnode forwards requests over a named pipe, so the socket has no remoteAddress
+  const app = fastify({
+    trustProxy: 1
+  })
+  t.after(() => app.close())
+
+  app.get('/pipe', function (req, reply) {
+    t.assert.strictEqual(req.raw.socket.remoteAddress, undefined)
+    t.assert.strictEqual(req.ip, '2.2.2.2', 'gets ip from x-forwarded-for')
+    t.assert.deepStrictEqual(req.ips, [undefined, '2.2.2.2'], 'gets ips from x-forwarded-for')
+    reply.send()
+  })
+
+  const socketPath = path.join(os.tmpdir(), `fastify-trust-proxy-${process.pid}.sock`)
+  await app.listen({ path: socketPath })
+
+  await new Promise((resolve, reject) => {
+    http.get({
+      socketPath,
+      path: '/pipe',
+      headers: { 'X-Forwarded-For': '1.1.1.1, 2.2.2.2' }
+    }, (res) => {
+      res.resume()
+      res.on('end', resolve)
+    }).on('error', reject)
+  })
+})
