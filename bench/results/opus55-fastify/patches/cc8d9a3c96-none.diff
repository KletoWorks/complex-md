+// Checks properties assigned directly in the constructor body (e.g. request.id),
+// walking the parent chain of derived constructors
+function hasInstanceProperty (konstructor, name) {
+  for (let k = konstructor; k; k = k.parent) {
+    if (Object.hasOwn(k, 'instanceProperties') && k.instanceProperties.has(name)) return true
+  }
+  return false
+}
