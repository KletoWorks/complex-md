diff --git a/test/decorator.test.js b/test/decorator.test.js
index 972658f9..ccd190a0 100644
--- a/test/decorator.test.js
+++ b/test/decorator.test.js
@@ -1328,3 +1328,51 @@ test('Request.setDecorator should update an existing decorator', (t, done) => {
     })
   })
 })
+
+test('hasRequestDecorator should detect constructor-assigned properties', t => {
+  const fastify = Fastify()
+  for (const name of ['id', 'params', 'raw', 'query', 'log', 'body']) {
+    t.assert.strictEqual(fastify.hasRequestDecorator(name), true, name)
+  }
+  t.assert.strictEqual(fastify.hasRequestDecorator('myExtra'), false)
+})
+
+test('hasReplyDecorator should detect constructor-assigned properties', t => {
+  const fastify = Fastify()
+  for (const name of ['raw', 'request', 'log']) {
+    t.assert.strictEqual(fastify.hasReplyDecorator(name), true, name)
+  }
+  t.assert.strictEqual(fastify.hasReplyDecorator('myExtra'), false)
+})
+
+test('decorateRequest should throw on constructor-assigned properties', t => {
+  const fastify = Fastify()
+  t.assert.throws(() => fastify.decorateRequest('id', null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' })
+  t.assert.throws(() => fastify.decorateRequest('body', null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' })
+  fastify.decorateRequest('myExtra', null)
+  t.assert.strictEqual(fastify.hasRequestDecorator('myExtra'), true)
+})
+
+test('decorateReply should throw on constructor-assigned properties', t => {
+  const fastify = Fastify()
+  t.assert.throws(() => fastify.decorateReply('raw', null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' })
+  t.assert.throws(() => fastify.decorateReply('request', null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' })
+  fastify.decorateReply('myExtra', null)
+  t.assert.strictEqual(fastify.hasReplyDecorator('myExtra'), true)
+})
+
+test('constructor-assigned properties should be detected inside encapsulated plugins', async t => {
+  const fastify = Fastify()
+  await fastify.register(async instance => {
+    t.assert.strictEqual(instance.hasRequestDecorator('id'), true)
+    t.assert.strictEqual(instance.hasReplyDecorator('raw'), true)
+    t.assert.throws(() => instance.decorateRequest('params', null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' })
+    t.assert.throws(() => instance.decorateReply('log', null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' })
+  })
+})
+
+test('constructor-assigned properties should be detected with trustProxy', t => {
+  const fastify = Fastify({ trustProxy: true })
+  t.assert.strictEqual(fastify.hasRequestDecorator('query'), true)
+  t.assert.throws(() => fastify.decorateRequest('raw', null), { code: 'FST_ERR_DEC_ALREADY_PRESENT' })
+})
