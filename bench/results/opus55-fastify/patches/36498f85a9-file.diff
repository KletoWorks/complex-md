+
+test('http/2 server close closes open sessions', async t => {
+  const fastify = Fastify({
+    http2: true,
+    http2SessionTimeout: 60000
+  })
+
+  fastify.get('/', () => ({}))
+
+  await fastify.listen({ port: 0 })
+
+  const url = getServerUrl(fastify)
+  const session = await connect(url)
+  const req = session.request({ ':method': 'GET', ':path': '/' })
+  req.resume()
+  req.end()
+  await once(req, 'end')
+
+  const sessionClosed = once(session, 'close')
+  await fastify.close()
+  await sessionClosed
+  t.assert.ok(session.closed || session.destroyed)
+})
