--- a/lib/server.js
+++ b/lib/server.js
@@ -283,9 +283,27 @@ function getServerInstance (options, httpHandler) {
 
   if (options.http2) {
     const server = typeof httpsOptions === 'object' ? http2.createSecureServer(httpsOptions, httpHandler) : http2.createServer(options.http, httpHandler)
-    server.on('session', (session) => session.setTimeout(options.http2SessionTimeout, () => {
-      session.close()
-    }))
+    const http2Sessions = new Map()
+    let sessionId = 0
+    server.on('session', (session) => {
+      const id = sessionId++
+      http2Sessions.set(id, session)
+      session.once('close', () => http2Sessions.delete(id))
+      session.setTimeout(options.http2SessionTimeout, () => {
+        session.close()
+      })
+    })
+
+    // http2 server.close() waits for all the sessions to end,
+    // so we close them gracefully to let fastify.close() complete
+    const serverClose = server.close
+    server.close = function (cb) {
+      const result = serverClose.call(this, cb)
+      for (const session of http2Sessions.values()) {
+        session.close()
+      }
+      return result
+    }
 
     server.setTimeout(options.connectionTimeout)
 
