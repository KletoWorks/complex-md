{
  "format": "complex-md/exposure-rules",
  "version": 1,
  "placeholders": [
    "^\\[redacted:",
    "\\$[{(]",
    "\\$[A-Z_][A-Z0-9_]{2,40}",
    "^\\$[A-Za-z_]",
    "^<[^>]{0,200}>$",
    "^%[^%]{0,200}%$",
    "^\\{\\{",
    "process\\.env",
    "os\\.environ",
    "getenv"
  ],
  "stopwords": [
    "example",
    "placeholder",
    "changeme",
    "your_",
    "your-",
    "xxxxxxxx",
    "dummy",
    "redacted"
  ],
  "rules": [
    {
      "id": "private-key",
      "slice": "E1",
      "title": "Private key block",
      "match": {
        "type": "content",
        "keywords": [
          "private key"
        ],
        "regex": "(-----BEGIN[A-Z0-9 ]{0,40}PRIVATE KEY(?: BLOCK)?-----[A-Za-z0-9+\\/=\\s:,\\\\]{0,12000}(?:-----END[A-Z0-9 ]{0,40}PRIVATE KEY(?: BLOCK)?-----)?)",
        "minLength": 60
      },
      "established": "exact",
      "severity": "critical",
      "confidence": "high",
      "cwe": "CWE-321",
      "directive": "Replace this key pair, then remove the private key from the file and from the git history."
    },
    {
      "id": "aws-access-key",
      "slice": "E1",
      "title": "AWS access key ID",
      "match": {
        "type": "content",
        "keywords": [
          "akia",
          "asia",
          "abia",
          "acca",
          "a3t"
        ],
        "regex": "\\b((?:A3T[A-Z0-9]|AKIA|ASIA|ABIA|ACCA)[A-Z2-7]{16})\\b"
      },
      "established": "exact",
      "severity": "critical",
      "confidence": "high",
      "cwe": "CWE-798",
      "directive": "Rotate this credential with AWS IAM, then remove it from the file and from the git history."
    },
    {
      "id": "aws-secret-key",
      "slice": "E1",
      "title": "AWS secret access key",
      "match": {
        "type": "content",
        "keywords": [
          "aws"
        ],
        "regex": "aws[A-Za-z0-9_.-]{0,20}(?:secret|private)[A-Za-z0-9_.-]{0,20}[\"']?[ \\t]{0,40}(?:=>|:=|=|:)[ \\t]{0,5}[\"'`]?([A-Za-z0-9\\/+]{40})(?:[^A-Za-z0-9\\/+=]|$)",
        "flags": "i",
        "minEntropy": 4
      },
      "established": "exact",
      "severity": "critical",
      "confidence": "medium",
      "cwe": "CWE-798",
      "directive": "Rotate this credential with AWS IAM, then remove it from the file and from the git history."
    },
    {
      "id": "github-token",
      "slice": "E1",
      "title": "GitHub token",
      "match": {
