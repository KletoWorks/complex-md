    "directory": "cli"
  },
  "type": "module",
  "bin": {
    "complex-md": "bin/complex-md.js"
  },
  "files": [
    "bin",
    "src",
    "prompts",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "coding-agents",
    "claude-code",
    "cursor",
    "codex",
    "agents-md",
    "hotspots",
    "git",
    "code-churn",
    "collateral-damage",
